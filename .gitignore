# This project lives inside its own VM root (~/vms), alongside VM data. Rather
# than list every VM by name, ignore the whole tree and un-ignore the project
# itself. VM directories, backups and any future storage can never be committed
# by accident.
/*

# systemd/ and sysvinit/ hold the autostart templates and stay un-ignored on
# purpose. Project-root detection no longer depends on them: it keys off
# blueprints/ and vmctl, because empty directories never survive a clone.
!/src/
!/blueprints/
!/systemd/
!/sysvinit/
!/README.md
!/SKILL.md
!/LICENSE
!/vmctl
!/vmhub
!/selftest
!/guicheck
!/.gitignore
# The unit suite and its config are project files, not VM data.
!/tests/
!/pytest.ini
# The README's screenshot. It needs un-ignoring like everything else: /* above
# ignores the whole root, so a new top-level file is invisible to `git add -A`
# and the README link 404s on GitHub while the local tree looks perfectly fine.
!/screenshot.png

# ...and drop the noise inside the directories we keep.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
