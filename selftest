VM = "vmhub-selftest"
BLUEPRINT = "alpine"

passed = 0
failed: list[str] = []


def _remmina_share_keys() -> set[str]:
    """Share-related config keys the installed Remmina RDP plugin registers.

    Read out of the plugin binary rather than a hand-written list, because a
    hand-written list is exactly how "sharepath" survived here for so long: it
    looked plausible and no Remmina on this machine had ever heard of it.

    Only the sharing keys are collected. A full key list cannot be used to
    validate the whole profile, because "name", "server", "port", "username"
    and "protocol" are read by Remmina's core rather than by the RDP plugin, so
    they would look invented. Returns an empty set when Remmina is absent, and
    the checks that use it are skipped rather than failed.
    """
    candidates = [
        Path("/usr/lib/remmina/plugins/remmina-plugin-rdp.so"),
        *sorted(Path("/usr/lib").glob("*-linux-gnu/remmina/plugins/remmina-plugin-rdp.so")),
    ]
    for path in candidates:
        try:
            blob = path.read_bytes()
        except OSError:
            continue
        tokens = {m.decode() for m in re.findall(rb"[ -~]{2,64}", blob)}
        return {
            t
            for t in tokens
            if re.fullmatch(r"[a-z][a-z0-9_]{1,24}", t)
            and ("share" in t or "drive" in t or "folder" in t)
        }
    return set()


def check(label: str, condition: bool, detail: str = "") -> None:
    global passed
    if condition:
        passed += 1
        print(f"  \033[32mPASS\033[0m  {label}")
    else:
        failed.append(label)
        print(f"  \033[31mFAIL\033[0m  {label}" + (f"  — {detail}" if detail else ""))


def section(title: str) -> None:
    print(f"\n\033[1m{title}\033[0m")


def _fake_guest_agent(path: str, *, fail: str | None = None) -> None:
    """A minimal QGA server, so the client protocol can be tested without a guest."""
    import socket as _socket
    import threading

    def serve() -> None:
        srv = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
        srv.bind(path)
        srv.listen(1)
        conn, _ = srv.accept()
        buf = b""
        conn.sendall(b'{"event":"GUEST_EXEC_STATUS","data":1}\n')  # stale buffered data
        while True:
            while b"\n" not in buf:
                chunk = conn.recv(4096)
                if not chunk:
                    conn.close()
                    srv.close()
                    return
                buf += chunk
            line, _, buf = buf.partition(b"\n")
            try:
                request = json.loads(line)
            except json.JSONDecodeError:
                continue
            command = request.get("execute")
            if fail and command == fail:
                conn.sendall(b'{"error":{"class":"GenericError","desc":"nope"}}\n')
            elif command == "guest-sync-delimited":
                ident = request["arguments"]["id"]
                conn.sendall(b"\xff" + json.dumps({"return": ident}).encode() + b"\n")
            elif command == "guest-ping":
                conn.sendall(b'{"return":{}}\n')
            elif command == "guest-get-osinfo":
                conn.sendall(b'{"return":{"hostname":"testhost","pretty-name":"TestOS"}}\n')
            elif command == "guest-network-get-interfaces":
                conn.sendall(json.dumps({"return": [
                    {"name": "lo", "ip-addresses": [
                        {"ip-address": "127.0.0.1", "ip-address-type": "ipv4"}]},
                    {"name": "eth0", "ip-addresses": [
                        {"ip-address": "fe80::1", "ip-address-type": "ipv6"},
                        {"ip-address": "10.0.0.5", "ip-address-type": "ipv4"}]},
                ]}).encode() + b"\n")

    threading.Thread(target=serve, daemon=True).start()


def _wait_for_socket(path: str, timeout: float = 3.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(path):
            return True
        time.sleep(0.02)
    return False


def _profile_roundtrip(vm: str) -> bool:
    """Write a Remmina profile for a VM, then confirm removal clears it."""
    from vmhub import rdp

    profile = rdp.profile_path(vm)
    profile.parent.mkdir(parents=True, exist_ok=True)
    profile.write_text("[remmina]\nname=x\n")
    temp = f"{vm}-profilecheck"
    lifecycle.create(temp, blueprint="alpine")
    rdp.write_profile(temp) if rdp.target(temp).available else None
    lifecycle.remove(temp)
    removed = not rdp.profile_path(temp).is_file()
    profile.unlink(missing_ok=True)
    return removed


def _write_test_data(disk_file: Path) -> None:
    """Write 512 bytes of guest data into a throwaway disk.

    Lets the install-state check run against a disk that looks installed,
    without needing a real guest to be installed into it.
    """
    with tempfile.TemporaryDirectory() as tmp:
        raw = Path(tmp) / "raw"
        raw.write_bytes(os.urandom(4096))
        source = Path(tmp) / "source.qcow2"
        disk.run(["convert", "-f", "raw", "-O", "qcow2", str(raw), str(source)])
        disk.run(
            ["dd", "-f", "qcow2", "-O", "qcow2", "bs=512", "count=1",
             f"if={source}", f"of={disk_file}"]
        )


def _make_fixture_iso(path: Path) -> Path:
    with open(path, "wb") as handle:
        handle.truncate(20 * 1024 * 1024)
        handle.seek(0x8000)
        handle.write(b"\x01CD001\x01" + b"\x00" * 0x26)
        handle.seek(0x8027)
        handle.write(b"VMHUBTST".ljust(32))
        handle.seek(0x8800)
        handle.write(b"\x00CD001\x01" + b"\x00" * 0x1E)
        handle.seek(0x8827)
        handle.write((0).to_bytes(4, "little"))
    return path


def main() -> int:
    # Point the app-wide defaults at a scratch file for the whole run. The real
    # ~/.config/vmhub/settings.toml belongs to the user: a test must neither
    # read it (its rdp_username would change what "no account is configured"
    # means) nor write to it.
    os.environ["VMHUB_CONFIG"] = str(Path(tempfile.mkdtemp(prefix="vmhub-cfg-")) / "settings.toml")
    # Every VM that exists before this run is somebody's VM, not ours. Record
    # them now and prove at the end that all of them survived: a test suite
    # that quietly removes the user's machines is worse than one that fails.
    # Only this run's own prefix is excluded -- a leftover from an earlier
    # aborted run is this suite's mess to clean, not the user's VM.
    preexisting = {
        name for name in registry.all_names() if not name.startswith(VM)
    }
    leftovers = [m for m in registry.iter_metas() if m.name.startswith(VM)]
    leftovers.sort(key=lambda m: (m.is_template, m.template_source is not None, m.name))
    for meta in leftovers:
        try:
            lifecycle.stop(meta.name, force=True)
        except VmhubError:
            pass
        try:
            lifecycle.remove(meta.name)
        except VmhubError as exc:
            print(f"  (could not remove leftover {meta.name}: {exc})")

    section("environment")
    check("podman is rootless", podman.is_rootless())
    check("oci runtime is crun", podman.oci_runtime() == "crun", podman.oci_runtime())
    check("host /dev/kvm is accessible", podman.host_has_kvm())

    section("create")
    lifecycle.create(VM, blueprint=BLUEPRINT)
    disk_file = paths.disk_path(VM)
    check("disk created outside the container's storage", disk_file.is_file())
    check("disk is qcow2", disk_file.is_file() and disk.format_of(disk_file) == "qcow2")
    check("disk is sparse", disk_file.is_file() and disk.actual_size(disk_file) < 1 << 30)
    check("spec round-trips", registry.load_spec(VM).name == VM)
    status = lifecycle.status(VM)
    check("viewer port assigned", status.viewer_port > 0, str(status.viewer_port))
    check(
        "ssh port assigned",
        any(guest == 22 for guest in status.ports.values()),
        str(status.ports),
    )

    section("start")
    lifecycle.start(VM)
    state = podman.state(VM)
    check("container is running", state == "running", state)
    for _ in range(60):
        if paths.qmp_path(VM).exists():
            break
        time.sleep(1)
    check("qmp socket present in host storage", paths.qmp_path(VM).exists())
    check(
        "no stray container-created disk",
        not list(paths.storage_dir(VM).glob(f"*/{paths.DISK_NAME}")),
    )

    section("snapshots")
    lifecycle.take_snapshot(VM, "clean")
    names = disk.snapshot_names(disk_file)
    check("snapshot recorded in the qcow2", "clean" in names, str(names))
    lifecycle.take_snapshot(VM, "later")
    lifecycle.revert(VM, "clean", restart=True)
    names = disk.snapshot_names(disk_file)
    check("revert discarded newer snapshots", names == ["clean"], str(names))
    lifecycle.take_snapshot(VM, "clean2")
    lifecycle.delete_snapshot(VM, "clean2")
    check("live snapshot delete works", "clean2" not in disk.snapshot_names(disk_file))

    section("snapshots remember their power state")
    power_vm = f"{VM}-power"
    lifecycle.create(power_vm, blueprint="alpine")
    power_disk = paths.disk_path(power_vm)

    # Powered off. This used to raise VmNotRunning outright.
    lifecycle.take_snapshot(power_vm, "off")
    check("a stopped VM can be snapshotted",
          "off" in disk.snapshot_names(power_disk),
          str(disk.snapshot_names(power_disk)))
    check("its power state is recorded as off",
          registry.load_meta(power_vm).snapshot_power.get("off") is False,
          str(registry.load_meta(power_vm).snapshot_power))

    # Powered on.
    lifecycle.start(power_vm)
    lifecycle.take_snapshot(power_vm, "on")
    check("a running VM records its power state as on",
          registry.load_meta(power_vm).snapshot_power.get("on") is True,
          str(registry.load_meta(power_vm).snapshot_power))
    lifecycle.stop(power_vm)

    # Reverting to the 'on' snapshot from a stopped VM powers it back up.
    lifecycle.revert(power_vm, "on")
    check("reverting to a running snapshot powers the VM back on",
          podman.state(power_vm) == "running", podman.state(power_vm))

    # An explicit override still wins over the recorded state. Done while
    # 'on' is still the newest snapshot, because reverting to 'off'
    # discards everything taken after it.
    lifecycle.revert(power_vm, "on", restart=False)
    check("an explicit restart=False overrides the recorded state",
          podman.state(power_vm) != "running", podman.state(power_vm))

    # Reverting to the 'off' snapshot leaves it off, and discards 'on'.
    lifecycle.revert(power_vm, "off")
    check("reverting to a powered-off snapshot leaves it off",
          podman.state(power_vm) != "running", podman.state(power_vm))
    check("reverting to an older snapshot discarded the newer one",
          "on" not in disk.snapshot_names(power_disk),
          str(disk.snapshot_names(power_disk)))
    check("and its recorded power state went with it",
          "on" not in registry.load_meta(power_vm).snapshot_power,
          str(registry.load_meta(power_vm).snapshot_power))

    # Deleting the last snapshot forgets its state too.
    lifecycle.delete_snapshot(power_vm, "off")
    check("deleting a snapshot forgets its power state",
          "off" not in registry.load_meta(power_vm).snapshot_power,
          str(registry.load_meta(power_vm).snapshot_power))

    section("template and clone")
    lifecycle.stop(VM)
    lifecycle.mark_template(VM)
    check("marked as template", registry.load_meta(VM).is_template)
    lifecycle.clone(f"{VM}-clone", VM)
    clone_disk = paths.disk_path(f"{VM}-clone")
    check("clone disk exists", clone_disk.is_file())
    backing = disk.backing_file(clone_disk)
    check("clone is a backing-file overlay", bool(backing), str(backing))
    check(
        "clone is far smaller than the template",
        disk.actual_size(clone_disk) < 1 << 22,
        spec.format_size(disk.actual_size(clone_disk)),
    )
    check("ports are distinct between template and clone",
          lifecycle.status(VM).viewer_port != lifecycle.status(f"{VM}-clone").viewer_port)

    section("template guard")
    lifecycle.start(f"{VM}-clone")
    try:
        lifecycle.start(VM)
        check("template cannot run while a clone is running", False, "start was allowed")
    except VmhubError:
        check("template cannot run while a clone is running", True)

    section("concurrency")
    lifecycle.clone(f"{VM}-clone2", VM)
    lifecycle.start(f"{VM}-clone2")
    running = [s.name for s in lifecycle.list_vms() if s.powered]
    check("two clones run at once", len(running) >= 2, str(running))

    section("flatten")
    lifecycle.stop(f"{VM}-clone")
    lifecycle.flatten(f"{VM}-clone")
    check("backing chain resolved", disk.backing_file(paths.disk_path(f"{VM}-clone")) is None)
    check("no longer marked as a clone", registry.load_meta(f"{VM}-clone").template_source is None)

    section("export and import")
    # A port the user added has to survive the trip. The bundle keeps the
    # entry and drops only the host number, which belonged to this machine.
    clone_net = registry.load_spec(f"{VM}-clone")
    if 5432 not in clone_net.network.guest_ports:
        clone_net.network.guest_ports = sorted({*clone_net.network.guest_ports, 5432})
    clone_net.network.ports.append(spec.Port(guest=5432, host=5433, name="Postgres"))
    registry.save_spec(clone_net)
    archive = export.export_vm(f"{VM}-clone")
    check("bundle written", archive.is_file(), str(archive))
    manifest = export.read_manifest(archive)
    check("manifest has a checksum", bool(manifest.get("disk", {}).get("sha256")))
    check("manifest pins the image", manifest.get("image", "").startswith("docker.io/qemux/qemu"))
    imported = export.import_bundle(archive, name=f"{VM}-imported")
    check("bundle imported", registry.exists(imported))
    original = registry.load_meta(f"{VM}-clone")
    copy = registry.load_meta(imported)
    check("imported VM got a fresh identity", original.uuid != copy.uuid)
    check("imported disk is standalone", disk.backing_file(paths.disk_path(imported)) is None)
    kept = [p for p in registry.load_spec(imported).network.ports if p.name == "Postgres"]
    check("a user port survives export and import", len(kept) == 1,
          str(registry.load_spec(imported).network.ports))
    check("and still points at the same guest port", bool(kept) and kept[0].guest == 5432, str(kept))
    check("with a host port of its own", bool(kept) and kept[0].host > 0, str(kept))
    check("that is not the one the bundle carried",
          bool(kept) and kept[0].host != 5433, str(kept))
    lifecycle.start(imported)
    check("imported VM boots", podman.state(imported) == "running")
    check("and the user port is still published after the start",
          5432 in registry.load_spec(imported).network.published().values(),
          str(registry.load_spec(imported).network.published()))
    lifecycle.stop(imported)

    section("install media")
    fixture = Path(__file__).resolve().parent / "selftest.iso"
    _make_fixture_iso(fixture)
    info = isomod.probe(fixture)
    check("synthetic ISO recognised", info.is_iso, info.reason)
    check("ISO label read", info.label == "VMHUBTST", repr(info.label))
    junk = fixture.with_suffix(".bin")
    junk.write_bytes(b"\x00" * 2_000_000)
    check("non-ISO rejected", not isomod.probe(junk).is_iso)
    try:
        isomod.validate(junk)
        check("validate() raises on non-ISO", False)
    except Exception:
        check("validate() raises on non-ISO", True)

    vm_spec_boot = registry.load_spec(VM)
    vm_spec_boot.boot.iso = "debian"
    registry.save_spec(vm_spec_boot)
    lifecycle.attach_iso(VM, isomod.INSTALL_SLOT, fixture)
    check("install ISO recorded in the spec",
          registry.load_spec(VM).media.install == str(fixture.resolve()))
    check("attaching an ISO clears the blueprint boot.iso",
          registry.load_spec(VM).boot.iso == "",
          repr(registry.load_spec(VM).boot.iso))
    env = registry.load_spec(VM).env(
        uuid=registry.load_meta(VM).uuid, mac=registry.load_meta(VM).mac
    )
    check("BOOT is not an auto-download keyword", env.get("BOOT", "") != "debian")
    entries = {e["slot"]: e for e in lifecycle.iso_status(VM)}
    check("install slot reports attached", entries[isomod.INSTALL_SLOT]["attached"])
    check("drivers slot reports empty", not entries[isomod.DRIVERS_SLOT]["attached"])
    argv = podman.run_argv(
        registry.load_spec(VM), registry.load_meta(VM).uuid,
        registry.load_meta(VM).mac, None,
    )
    check("install ISO bind-mounted read-only",
          any(a.endswith(":/start.iso:ro") for a in argv), "no /start.iso:ro mount")
    check("disk shadow-mounted so the container sees it",
          any(a.endswith(":/storage/data.qcow2") for a in argv), "no disk shadow mount")

    lifecycle.attach_iso(VM, isomod.DRIVERS_SLOT, fixture)
    argv = podman.run_argv(
        registry.load_spec(VM), registry.load_meta(VM).uuid,
        registry.load_meta(VM).mac, None,
    )
    check("drivers ISO bind-mounted read-only",
          any(a.endswith(":/drivers.iso:ro") for a in argv), "no /drivers.iso:ro mount")

    fixture.unlink()
    try:
        podman.run_argv(
            registry.load_spec(VM), registry.load_meta(VM).uuid,
            registry.load_meta(VM).mac, None,
        )
        check("missing ISO is a hard error", False, "startup would fail obscurely")
    except VmhubError as exc:
        check("missing ISO is a hard error", "missing" in str(exc), str(exc)[:60])

    lifecycle.detach_iso(VM, isomod.INSTALL_SLOT)
    lifecycle.detach_iso(VM, isomod.DRIVERS_SLOT)
    check("ISOs detached", registry.load_spec(VM).media.install == "")

    conflicting = registry.load_spec(VM)
    conflicting.boot.iso = "debian"
    registry.save_spec(conflicting)
    lifecycle.attach_iso(VM, isomod.INSTALL_SLOT, _make_fixture_iso(fixture))
    conflicting = registry.load_spec(VM)
    conflicting.boot.iso = "debian"
    registry.save_spec(conflicting)
    notices = lifecycle.status(VM).notices
    check("conflict between ISO and boot.iso is reported",
          any("boot.iso" in n for n in notices), str(notices))
    check("empty-disk fallback is reported",
          any("60 MB" in n for n in notices), str(notices))
    lifecycle.detach_iso(VM, isomod.INSTALL_SLOT)
    fixture.unlink(missing_ok=True)
    junk.unlink(missing_ok=True)

    section("rdp")
    spec_rdp = registry.load_spec(VM)
    spec_rdp.network.guest_ports = [3389]
    spec_rdp.network.set_role("rdp", 3389, 13389)
    registry.save_spec(spec_rdp)
    tgt = rdp.target(VM)
    check("rdp target resolved", tgt.port == 13389)
    check("rdp uri well formed", tgt.uri().startswith("rdp://"), tgt.uri())
    check("rdp uri never embeds the password",
          not tgt.password or tgt.password not in tgt.uri(), tgt.uri())
    check("rdp uri with a password is opt-in",
          "admin" in rdp.RdpTarget("h", 1, "u", "admin").uri(include_password=True))
    check("rdp user is a placeholder, not a guessed account",
          tgt.user in {"", "Administrator"}, repr(tgt.user))
    check("no password without a known account", not tgt.password or bool(tgt.user))
    check("freerdp argv has the port", "13389" in " ".join(tgt.freerdp_argv()))
    profile = rdp.write_profile(VM)
    parsed = configparser.ConfigParser()
    parsed.read(profile)
    profile_section = parsed["remmina"]
    check("remmina profile embeds the port in server",
          profile_section["server"].endswith(":13389"), profile_section["server"])
    check("remmina profile also sets port",
          profile_section["port"] == "13389", profile_section["port"])
    check("remmina profile points at the bind address",
          profile_section["server"] == f"{tgt.host}:13389", profile_section["server"])
    check("remmina profile carries no password", profile_section["password"] == "")
    rdp.remove_profile(VM)
    no_rdp_spec = registry.load_spec(VM)
    saved = no_rdp_spec.network.host_for("rdp")
    no_rdp_spec.network.set_role("rdp", 3389, 0)
    registry.save_spec(no_rdp_spec)
    ok_flag, ok_msg = rdp.probe(VM)
    check("probe refuses a VM with no rdp port", not ok_flag and "no RDP port" in ok_msg, ok_msg)
    no_rdp_spec.network.set_role("rdp", 3389, saved)
    registry.save_spec(no_rdp_spec)
    check("probe reports the negotiated protocol",
          "RDP 5.0+" in rdp.RDP_PROTOCOLS.get(2, ""), rdp.RDP_PROTOCOLS.get(2, ""))
    spec_rdp.network.set_role("rdp", 3389, 0)
    registry.save_spec(spec_rdp)
    check("no rdp port means unavailable", not rdp.target(VM).available)

    section("app-wide defaults")
    check("an absent settings file reads as all-empty",
          settings.load() == {key: "" for key in settings.FIELDS}, settings.load())
    settings.set_value("rdp_username", "gero")
    settings.set_value("share_path", "/home/admin/Shared")
    reread = settings.load()
    check("a saved account default is read back",
          reread["rdp_username"] == "gero", reread)
    check("a saved folder default is read back",
          reread["share_path"] == "/home/admin/Shared", reread)
    check("the file explains itself",
          all(d in settings.config_path().read_text() for d in settings.FIELDS.values()),
          settings.config_path().read_text())

    defaults_vm = f"{VM}-defaults"
    lifecycle.create(defaults_vm, blueprint="alpine")
    dspec = registry.load_spec(defaults_vm)
    dspec.media.rdp_user = ""
    dspec.network.guest_ports = [3389]
    dspec.network.set_role("rdp", 3389, 13390)
    registry.save_spec(dspec)
    check("a VM with no account falls back to the app-wide default",
          rdp.rdp_user(defaults_vm) == "gero", rdp.rdp_user(defaults_vm))
    dspec.media.rdp_user = "neo"
    registry.save_spec(dspec)
    check("a VM's own account beats the default",
          rdp.rdp_user(defaults_vm) == "neo", rdp.rdp_user(defaults_vm))
    dspec.media.rdp_user = ""
    registry.save_spec(dspec)

    shared_profile = rdp.write_profile(defaults_vm)
    shared_text = shared_profile.read_text()
    check("the shared folder reaches the remmina profile",
          f"drive=/home/admin/Shared" in shared_text,
          [line for line in shared_text.splitlines() if "drive" in line])
    check("the default account reaches the profile",
          "username=gero" in shared_text,
          [line for line in shared_text.splitlines() if line.startswith("username")])
    check("rdp.share_path reports the inherited default",
          rdp.share_path(defaults_vm) == "/home/admin/Shared",
          rdp.share_path(defaults_vm))
    dspec.media.share_path = "/home/admin/Other"
    registry.save_spec(dspec)
    check("a VM's own folder overrides the default",
          rdp.share_path(defaults_vm) == "/home/admin/Other",
          rdp.share_path(defaults_vm))
    own_text = rdp.write_profile(defaults_vm).read_text()
    check("and the override is what lands in the profile",
          "drive=/home/admin/Other" in own_text
          and "drive=/home/admin/Shared" not in own_text,
          [line for line in own_text.splitlines() if "drive" in line])
    check("media.share_path survives a spec round-trip",
          registry.load_spec(defaults_vm).media.share_path == "/home/admin/Other",
          registry.load_spec(defaults_vm).media.share_path)
    dspec.media.share_path = ""
    registry.save_spec(dspec)
