    before_text = atomic_path.read_text()
    atomic_spec = registry.load_spec(atomic_vm)
    spec.save(atomic_spec, atomic_path)
    check("a save leaves the spec readable", atomic_path.read_text() == before_text,
          atomic_path.read_text()[:80])
