    check("Delete is a button on the pane header, not only in a menu",
          "delete_button" in (ui_dir / "pane.py").read_text())

    # Publishing an RDP port used to set media.rdp_user to the literal string
    # "user". That made the field non-empty, so the Remmina prompt -- the one
    # thing that could ask for the real account -- could never appear, and the
    # session failed NLA with no way to fix it from the GUI.
    pane_src = (ui_dir / "pane.py").read_text()
    check("publishing an RDP port does not invent an account",
          'media.rdp_user = "user"' not in pane_src,
          "the add-role path must not write a placeholder account")

    # The Finish install button used to exist only inside a notice, so it
    # vanished on any VM with nothing to detach, with nothing to say so.
    check("the Finish install button is built, not only noticed",
          "self.finish_install_button = Gtk.Button" in pane_src,
          "pane.py must build finish_install_button unconditionally")
    check("its sensitivity follows finish_install_needed",
          "finish_install_needed" in pane_src,
          "the button must be driven by status.finish_install_needed")

    # "Test connection" is gone. It spoke RDP to the port and reported into the
    # status bar, which the 4-second poll overwrote, so it said nothing in
    # practice. The RDP options it sat next to are what a session actually
    # needs, and those are editable fields now. Matched on the attribute, not
    # the word "Test connection": this comment mentions that phrase.
    check("the RDP probe button is gone from the console tab",
          "rdp_test_button" not in pane_src,
          "the probe button attribute must no longer exist")
    check("nothing in the GUI still calls rdp.probe",
          "rdp.probe(" not in pane_src,
          "the probe button and the per-port Test button both called it")
    check("the RDP account is an editable field",
          "self.rdp_user_entry = Gtk.Entry()" in pane_src,
          "the account needs a text box, not a one-shot prompt")
    check("the shared folder is an editable field with a chooser",
          "self.share_entry = Gtk.Entry()" in pane_src
          and "Gtk.FileDialog" in pane_src,
          "a path selector needs an entry and a Browse button")
    # Having the widget is not the same as it working. Browse used a
    # one-argument done(folder) callback where PyGObject calls
    # (dialog, result), so picking a folder raised TypeError, the traceback went
    # nowhere, and the button looked like it selected nothing -- while the check
    # above, which only looks for the widget, passed happily.
    browse_src = pane_src.split("def _on_share_browse", 1)[-1].split("\n    def ", 1)[0]
    check("the Browse callback uses the async-result shape PyGObject calls",
          "select_folder_finish(result)" in browse_src
          and "def on_selected(source, result)" in browse_src,
          "a one-argument callback raises before it can read the folder")
    check("no chooser callback is left with a single argument",
          "def done(folder)" not in pane_src
          and "def on_selected(folder)" not in pane_src,
          "select_folder/select pass (source, result) and need *_finish()")
    check("the Remmina button stays and explains itself",
          "self.remmina_button.set_sensitive(" in pane_src
          and "self.remmina_button.set_visible(" not in pane_src,
          "it must not vanish when it cannot be used, only say why")

    # A menu entry "row.delete" means "the action `delete` in the group named
    # `row`". The actions used to be added to the window instead, and a
    # PopoverMenu parented to a sidebar row does not resolve the window's
    # actions -- so every item went grey with its label drawn perfectly
    # normally. The header's overflow menu had the same defect with win.*.
    install = ""
    win_install = ""
    for _cls, fn, src in gui_methods(ui_dir / "window.py"):
        if fn == "_install_row_actions":
            install = src
        elif fn == "_install_win_actions":
            win_install = src
    wanted = sorted(set(re.findall(r"row\.(\w+)::", attach)))
    check("the sidebar menu names some actions to check",
          bool(wanted), "no row.<name>:: entries found in _attach_row_menu")
    check("sidebar actions go in a group the row popovers can reach",
          'insert_action_group("row"' in install,
          '_install_row_actions must insert_action_group("row", ...) on the list box')
    check("sidebar actions are added to that group, not to the window",
          "group.add_action(action)" in install and "self.add_action" not in install,
          "add_action on the window is not reachable from a row's popover")
    check("the header overflow menu's actions go in a win group too",
          'insert_action_group("win"' in win_install,
          'the overflow menu asks for win.* and needs that group inserted')
    registered = re.search(r'for action_name in \(([^)]*)\)', install)
    listed = sorted(re.findall(r'"(\w+)"', registered.group(1))) if registered else []
    check("every sidebar menu action is registered",
          set(wanted) <= set(listed),
          f"menu asks for {wanted}, registered {listed}")

    # A handler that builds a dialog directly (rather than via prompt_text) must
    # also show it; TextPrompt does not present itself any more, but this catches
    # any future dialog that gets constructed and dropped.
    unshown: list[str] = []
    for path in sorted(ui_dir.glob("*.py")):
        for cls, name, body in gui_methods(path):
            if not name.startswith("_on"):
                continue
            builds = "TextPrompt(" in body or "AlertDialog(" in body
            if not builds or "prompt_text(" in body:
                continue
            if not any(call in body for call in (".present(", ".choose(", ".show(")):
                unshown.append(f"{path.name}:{cls}.{name}")
    check("every dialog-building handler can show its dialog", not unshown, str(unshown))

    # Every button that opens a dialog must be reachable: a handler defined but
    # never connected is another way a button silently does nothing.
    pane_src = (ui_dir / "pane.py").read_text()
    defined = {name for _cls, name, _b in gui_methods(ui_dir / "pane.py") if name.startswith("_on")}
    # Handlers are connected directly or wrapped in a lambda supplying an argument,
    # so look for any self.<name> reference rather than only `connect(..., self.x)`.
    unused_handlers = sorted(n for n in defined if f"self.{n}" not in pane_src)
    check("no orphaned click handlers in the pane", not unused_handlers, str(unused_handlers))

    section("signal handlers accept the widget they are given")
    # GTK hands the emitting widget to "clicked". A handler wired straight to
    # a signal has to take it: a zero-argument method connected directly
    # raises TypeError the moment anyone presses the button, and the only
    # symptom is a control that looks fine and does nothing. The guicheck
    # sweep cannot catch this, because it calls handlers with no arguments.
    ui_dir = paths.project_root() / "src" / "vmhub" / "ui"
    bad_arity: list[str] = []
    for ui_path in sorted(ui_dir.glob("*.py")):
        tree = ast.parse(ui_path.read_text())
        connected: set[str] = set()
        for node in ast.walk(tree):
            if (
                isinstance(node, ast.Call)
                and isinstance(node.func, ast.Attribute)
                and node.func.attr == "connect"
                and len(node.args) >= 2
                and isinstance(node.args[1], ast.Attribute)
                and isinstance(node.args[1].value, ast.Name)
                and node.args[1].value.id == "self"
            ):
                connected.add(node.args[1].attr)
        for cls in [n for n in tree.body if isinstance(n, ast.ClassDef)]:
            for fn in cls.body:
                if not isinstance(fn, ast.FunctionDef):
                    continue
                if fn.name not in connected and f"{cls.name}.{fn.name}" not in connected:
                    continue
                takes = fn.args.posonlyargs + fn.args.args
                if len(takes) < 2 and not fn.args.vararg:
                    bad_arity.append(f"{ui_path.name}:{fn.lineno} {fn.name}")
    check("every directly connected handler takes the widget",
          not bad_arity, str(bad_arity))

    # A worker runs on a thread, where touching a widget is not safe, and it
    # reads whatever the value happens to be at that moment rather than the
    # one the user set. Read the controls before dispatching the work.
    worker_touches: list[str] = []
    widget_calls = {
        "set_text", "get_text", "set_visible", "get_visible", "set_sensitive",
        "set_active", "get_active", "set_label", "get_label", "set_value",
        "get_value", "set_tooltip_text", "emit", "get_clipboard",
        "get_selected", "get_first_child", "get_next_sibling", "queue_draw",
        "set_markup", "push", "pop", "report",
    }

    def _rooted_at_self(node) -> bool:
        while isinstance(node, ast.Attribute):
            node = node.value
        return isinstance(node, ast.Name) and node.id == "self"

    for ui_path in sorted(ui_dir.glob("*.py")):
        tree = ast.parse(ui_path.read_text())
        for fn in ast.walk(tree):
            if not isinstance(fn, ast.FunctionDef) or fn.name != "work":
                continue
            for sub in ast.walk(fn):
                if (
                    isinstance(sub, ast.Call)
                    and isinstance(sub.func, ast.Attribute)
                    and sub.func.attr in widget_calls
                    and _rooted_at_self(sub.func.value)
                ):
                    worker_touches.append(f"{ui_path.name}:{sub.lineno} {sub.func.attr}")
    check("no worker touches a widget from its own thread",
          not worker_touches, str(worker_touches))

    section("ports and orphans")
    rival = f"{VM}-rival"
    lifecycle.create(rival, blueprint="alpine")
    mine = registry.load_spec(VM)
    theirs = registry.load_spec(rival)
    for role in ("web", "ssh"):
        theirs.network.set_role(role, ports.ROLE_GUEST[role], mine.network.host_for(role))
    registry.save_spec(theirs)
    check("a forced clash is detected", bool(ports.collisions()))
    lifecycle.start(rival, progress=None)
    check("starting the VM repairs its own ports",
          not ports.collisions(), str(ports.collisions()))
    check("the repaired VM kept working",
          podman.state(rival) == "running", podman.state(rival))
    lifecycle.stop(rival, mode="force", progress=None)
    lifecycle.remove(rival, progress=None)

    stale = f"{VM}-stale"
    lifecycle.create(stale, blueprint="alpine")
    lifecycle.start(stale, progress=None)
    paths.vm_dir(stale).rename(paths.project_root() / f"{stale}-gone")
    check("a renamed-away VM leaves an orphan",
          any(o["container"] == f"vmhub-{stale}" for o in podman.orphans()),
          str(podman.orphans()))
    check("prune reports the removal",
          any(f"vmhub-{stale}" in line for line in podman.prune_orphans()),
          str(podman.prune_orphans()))
    check("the container is really gone",
          not podman.container_exists(f"vmhub-{stale}"))
    shutil.rmtree(paths.project_root() / f"{stale}-gone", ignore_errors=True)

    section("stop modes")
    stopper = f"{VM}-stop"
    lifecycle.create(stopper, blueprint="alpine")
    stop_spec = registry.load_spec(stopper)
    stop_spec.shutdown.timeout = 5
    registry.save_spec(stop_spec)
    check("shutdown timeout is configurable",
          registry.load_spec(stopper).shutdown.timeout == 5)
    check("timeout reaches the container env",
          registry.load_spec(stopper).env(uuid="u", mac="m")["TIMEOUT"] == "5")
    for mode in ("graceful", "power", "force"):
        lifecycle.start(stopper)
        check(f"started for {mode} stop", podman.state(stopper) == "running")
        used = lifecycle.stop(stopper, mode=mode)
        check(f"{mode} stop reports its mode", used == mode)
        check(f"{mode} stop leaves the container stopped",
              podman.state(stopper) in {"exited", "absent"}, podman.state(stopper))
    try:
        lifecycle.stop(stopper, mode="nonsense")
        check("unknown stop mode rejected", False)
    except Exception:
        check("unknown stop mode rejected", True)
    check("stopping an already-stopped VM is a no-op",
          lifecycle.stop(stopper, mode="force") == "force")
    lifecycle.remove(stopper)

    section("resource changes")
    vm_spec = registry.load_spec(f"{VM}-clone")
    vm_spec.resources.ram = "2G"
    registry.save_spec(vm_spec)
    before = disk.virtual_size(paths.disk_path(f"{VM}-clone"))
    lifecycle.resize(f"{VM}-clone", "12G")
    after = disk.virtual_size(paths.disk_path(f"{VM}-clone"))
    check("disk grew", after > before, f"{before} -> {after}")
    try:
        lifecycle.resize(f"{VM}-clone", "1G")
        check("shrink is refused", False, "shrink was allowed")
    except VmhubError:
        check("shrink is refused", True)

    section("the alpine fallback is never a surprise")
    fresh = f"{VM}-fresh"
    lifecycle.create(fresh)
    fresh_msgs: list[str] = []
    lifecycle.start(fresh, progress=fresh_msgs.append)
    fresh_notices = lifecycle.status(fresh).notices
    lifecycle.stop(fresh)
    check("starting an empty-disk VM warns that Alpine is attached",
          any("Alpine" in m for m in fresh_msgs), str(fresh_msgs[:4]))
    check("the warning explains the boot-order consequence",
          any("boot order" in m for m in fresh_msgs), str(fresh_msgs[:4]))
    check("the status notice names Alpine rather than a mystery image",
          any("Alpine" in n for n in fresh_notices), str(fresh_notices))
    check("the status notice no longer claims it never boots ahead of your ISO",
          not any("never boots ahead" in n for n in fresh_notices),
          str(fresh_notices))

    chosen = f"{VM}-chosen"
    lifecycle.create(chosen, blueprint="alpine")
    chosen_msgs: list[str] = []
    lifecycle.start(chosen, progress=chosen_msgs.append)
    lifecycle.stop(chosen)
    check("a VM that explicitly asked for alpine is not warned about it",
          not any("Alpine" in m for m in chosen_msgs), str(chosen_msgs[:4]))

    section("secrets never leave the process")
    check("no password is invented when none is configured",
          rdp.RdpTarget("h", 1, "u", "").password == "")
    check("an empty password produces no freerdp /p: flag",
          not any(a.startswith("/p:")
                  for a in rdp.RdpTarget("h", 1, "u", "").freerdp_argv()))
    check("a configured password still reaches freerdp",
          any(a == "/p:real-pw"
              for a in rdp.RdpTarget("h", 1, "u", "real-pw").freerdp_argv()))

    secret_vm = f"{VM}-secret"
    lifecycle.create(secret_vm, blueprint="alpine")
    secret_spec = registry.load_spec(secret_vm)
    secret_spec.display.protected = True
    secret_spec.display.password = "console-pw-canary"
    secret_spec.media.rdp_user = "Administrator"
    registry.save_spec(secret_spec)
    check("a known account with no password gets no password",
          rdp.target(secret_vm).password == "", rdp.target(secret_vm).password)
    secret_spec = registry.load_spec(secret_vm)
    secret_spec.media.rdp_password = "rdp-pw-canary"
    registry.save_spec(secret_spec)

    secret_archive = export.export_vm(secret_vm)
    secret_manifest = export.read_manifest(secret_archive)
    check("export keeps the console password out of the manifest",
          "console-pw-canary" not in json.dumps(secret_manifest))
    check("export keeps the rdp password out of the manifest",
          "rdp-pw-canary" not in json.dumps(secret_manifest))
    check("the exported spec is not left marked protected",
          secret_manifest["spec"]["display"].get("protected", False) is False,
          str(secret_manifest["spec"]["display"]))
    with export.tarfile.open(secret_archive, "r:*") as secret_tar:
        packed = b"".join(
            secret_tar.extractfile(m).read()
            for m in secret_tar.getmembers()
            if m.isfile() and m.size < 2_000_000
        )
    check("no secret anywhere in the bundle",
          b"console-pw-canary" not in packed and b"rdp-pw-canary" not in packed)

    section("settings survive a save and reload")
    rt = f"{VM}-roundtrip"
    lifecycle.create(rt, blueprint="debian13")
    rt_spec = registry.load_spec(rt)
    rt_spec.features.guest_agent = False
    rt_spec.features.hv = False
    rt_spec.resources.kvm = False
    rt_spec.shutdown.timeout = 0
    registry.save_spec(rt_spec)
    back = registry.load_spec(rt)
    check("features.guest_agent=false survives a reload",
          back.features.guest_agent is False, str(back.features))
    check("features.hv=false survives a reload",
          back.features.hv is False, str(back.features))
    check("resources.kvm=false survives a reload",
          back.resources.kvm is False, str(back.resources))
    check("shutdown.timeout=0 survives a reload",
          back.shutdown.timeout == 0, str(back.shutdown.timeout))
    check("the reloaded spec reaches the container env",
          "QGA" not in back.env(uuid="u", mac="m"), str(back.env(uuid="u", mac="m")))
    check("empty strings are still pruned from the file",
          "media_type" not in back.to_dict().get("boot", {}),
          str(back.to_dict().get("boot", {})))
    check("an explicit false is written out",
          back.to_dict()["features"].get("guest_agent") is False,
          str(back.to_dict().get("features", {})))

    section("finish install is offered exactly when it helps")
    fi = f"{VM}-finishinstall"
    # No blueprint: a blueprint sets boot.iso, and finish_install()
    # legitimately has something to clear in that case.
    lifecycle.create(fi)
    check("a fresh VM with nothing attached does not need finishing",
          lifecycle.status(fi).finish_install_needed is False,
          str(lifecycle.status(fi).notices))
    fi_spec = registry.load_spec(fi)
    fi_spec.media.install = "/tmp/does-not-need-to-exist.iso"
    registry.save_spec(fi_spec)
    check("an attached install ISO means finishing is needed",
          lifecycle.status(fi).finish_install_needed is True,
          str(lifecycle.status(fi).notices))
    check("and the advice is shown in the same refresh",
          any("install ISO" in n for n in lifecycle.status(fi).notices),
          str(lifecycle.status(fi).notices))
    check("and the GUI is told which action resolves it",
          any(getattr(n, "action", "") == "finish-install"
              for n in lifecycle.status(fi).notices),
          str([getattr(n, "action", "") for n in lifecycle.status(fi).notices]))
    fi_spec = registry.load_spec(fi)
    fi_spec.media.install = ""
    registry.save_spec(fi_spec)
    check("detaching the ISO removes the need again",
          lifecycle.status(fi).finish_install_needed is False,
          str(lifecycle.status(fi).notices))
    fi_actions = lifecycle.finish_install(fi)
    check("finish-install is a no-op on a clean VM",
          fi_actions == [], str(fi_actions))

    section("honest failure messages")
    class _Result:
        returncode = 1
        stderr = "Failed to connect to bus: No such file or directory\n"
        stdout = ""
    line = autostart._enable_failure(_Result())
    check("a failed enable yields a string, not a list", isinstance(line, str), repr(line))
    check("a failed enable surfaces the real reason",
          "No such file" in line, line)
    _Result.stderr = ""
    _Result.stdout = ""
    silent = autostart._enable_failure(_Result())
    check("a silent failure still yields a readable string",
          isinstance(silent, str) and "could not enable" in silent, repr(silent))

    # The old verdict was `"NOT" in value or value == "no"`, which the
    # rootless row defeated with the string "NO - containers run as root".
    # Faking that one condition proves the row is now really judged.
    import argparse as _argparse
    import contextlib as _contextlib
    import io as _io

    real_rootless = podman.is_rootless
    podman.is_rootless = lambda: False
    try:
        doctor_buf = _io.StringIO()
        with _contextlib.redirect_stdout(doctor_buf):
            doctor_rc = cli.cmd_doctor(_argparse.Namespace(), cli.Out())
    finally:
        podman.is_rootless = real_rootless
    doctor_text = doctor_buf.getvalue()
    check("doctor names the root-podman condition",
          "NO - containers run as root" in doctor_text, doctor_text[:160])
    check("doctor exits non-zero for a root podman", doctor_rc != 0, str(doctor_rc))
    check("doctor does not claim all good in that case",
          "all good" not in doctor_text, doctor_text[-140:])

    section("port list")
    pvm = f"{VM}-ports"
    lifecycle.create(pvm, blueprint="alpine")
    pnet = registry.load_spec(pvm).network
    check("a new VM starts with a web and an ssh entry",
          {p.role for p in pnet.ports if p.role} == {"web", "ssh"},
          str([(p.role, p.host) for p in pnet.ports]))
    check("the web console is published", pnet.host_for("web") > 0, str(pnet.host_for("web")))
    check("no rdp entry until one is asked for", pnet.by_role("rdp") is None)
    check("and no entry is left unpublished",
          all(port.host for port in pnet.ports),
          str([(port.role, port.host) for port in pnet.ports]))

    registry.save_spec(registry.load_spec(pvm))
    reread = registry.load_spec(pvm).network
    check("the port list survives a save and reload",
          [(p.guest, p.host, p.role) for p in reread.ports]
          == [(p.guest, p.host, p.role) for p in pnet.ports],
          str([(p.guest, p.host, p.role) for p in reread.ports]))
    written = paths.spec_path(pvm).read_text()
    check("it is written as a table array", "[[network.ports]]" in written, written[-300:])
    check("the old fixed slots are gone from the file", "host_web" not in written)

    # A spec written before the list existed still names its ports. It has to
    # keep working, and the next save has to move it to the new form.
    legacy = spec.spec_from_dict({
        "name": pvm,
        "network": {
            "mode": "user", "guest_ports": [22, 3389], "bind": "127.0.0.1",
            "host_web": 8006, "host_ssh": 2222, "host_rdp": 3389,
        },
    })
    check("an old spec's fixed slots still load as entries",
          [(p.role, p.guest, p.host) for p in legacy.network.ports]
          == [("web", 8006, 8006), ("ssh", 22, 2222), ("rdp", 3389, 3389)],
          str([(p.role, p.guest, p.host) for p in legacy.network.ports]))
    scratch = Path(tempfile.mkdtemp()) / "vm.toml"
    spec.save(legacy, scratch)
    legacy_written = scratch.read_text()
    check("saving it writes the list instead of the old keys",
          "[[network.ports]]" in legacy_written and "host_web" not in legacy_written,
          legacy_written[-300:])
    reread_legacy = spec.load(scratch, name="legacy")
    check("and it reads back the same",
          [(p.role, p.guest, p.host) for p in reread_legacy.network.ports]
          == [("web", 8006, 8006), ("ssh", 22, 2222), ("rdp", 3389, 3389)],
          str([(p.role, p.guest, p.host) for p in reread_legacy.network.ports]))
    check("a half-written old spec loads without inventing ports",
          spec.spec_from_dict({"name": "x", "network": {"host_ssh": 2222}}).network.host_for("web") == 0)

    def run_ports(*argv) -> tuple[int, str]:
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = cli.cmd_ports(cli.build_parser().parse_args(["ports", pvm, *argv]), cli.Out())
        return rc, buf.getvalue()

    rc, text = run_ports("add", "5432", "--name", "Postgres")
    check("a guest port can be added", rc == 0, text.strip())
    pnet = registry.load_spec(pvm).network
    pg = [p for p in pnet.ports if p.name == "Postgres"]
    check("it lands in the list with its label", len(pg) == 1, str(pnet.ports))
    check("with a host port picked for it", bool(pg) and pg[0].host > 0, str(pg))
    check("the guest port is forwarded as well", 5432 in pnet.guest_ports, str(pnet.guest_ports))
    check("published() reports it", pnet.published().get(pg[0].host) == 5432, str(pnet.published()))
    argv = podman.run_argv(
        registry.load_spec(pvm), registry.load_meta(pvm).uuid,
        registry.load_meta(pvm).mac, None,
    )
    check("the container is told to forward it",
          f"{pnet.bind or '127.0.0.1'}:{pg[0].host}:5432" in argv, "no -p for 5432")

    rc, text = run_ports("add", "--as", "ssh")
    check("a second ssh port is refused", rc == 1 and "already publishes" in text, text.strip())
    check("and the refusal points at the way to move it", "ports set" in text, text.strip())

    rc, text = run_ports("add", "--as", "rdp")
    check("an rdp port can be added by role", rc == 0, text.strip())
    check("adding it forwards 3389 too", 3389 in registry.load_spec(pvm).network.guest_ports)
    check("rdp.target resolves to it",
          rdp.target(pvm).port == registry.load_spec(pvm).network.host_for("rdp"))
    rc, text = run_ports("rm", "rdp")
    check("and removed again by role", rc == 0, text.strip())
    check("after which rdp reports unavailable", not rdp.target(pvm).available)

    first_host = pg[0].host
    rc, text = run_ports("set", str(first_host), "--host", "16000")
    check("a port can be moved to another host port", rc == 0, text.strip())
    moved = [p for p in registry.load_spec(pvm).network.ports if p.name == "Postgres"]
    check("and it really moved", bool(moved) and moved[0].host == 16000, str(moved))
    rc, text = run_ports("set", "16000", "--host", "16000")
    check("setting a port to the host it already has is a clean no-op",
          rc == 0 and "already host 16000" in text, text.strip())
    rc, text = run_ports("set", str(first_host), "--host", "16000")
    check("naming a host port that has moved is an error, not a silent no-op",
          rc == 1 and "publishes no port" in text, text.strip())
    rc, text = run_ports("set", "16000", "--guest", "5433")
    check("a mistyped guest number can be corrected in place", rc == 0, text.strip())
    fixed = [p for p in registry.load_spec(pvm).network.ports if p.host == 16000]
    check("and the corrected guest number is the one published",
          bool(fixed) and fixed[0].guest == 5433, str(fixed))
    check("and the old one stops being forwarded",
          5432 not in registry.load_spec(pvm).network.guest_ports
          and 5433 in registry.load_spec(pvm).network.guest_ports,
          str(registry.load_spec(pvm).network.guest_ports))
    check("and the port keeps its label", bool(fixed) and fixed[0].name == "Postgres", str(fixed))
    rc, text = run_ports("set", "16000")
    check("a set with neither --host nor --guest is refused",
          rc == 2 and "give the new host port" in text, text.strip())
    rc, text = run_ports("rm", "nope")
    check("removing a port that is not there fails cleanly",
          rc == 1 and "publishes no port" in text, text.strip())
    rc, text = run_ports("rm", "16000")
    check("removing by host port works", rc == 0, text.strip())
    check("and it leaves published()", 16000 not in registry.load_spec(pvm).network.published())
    check("and stops forwarding the guest port it had switched on",
          5433 not in registry.load_spec(pvm).network.guest_ports,
          str(registry.load_spec(pvm).network.guest_ports))
    check("but leaves a port something else still publishes alone",
          22 in registry.load_spec(pvm).network.guest_ports,
          str(registry.load_spec(pvm).network.guest_ports))

    clash = registry.load_spec(pvm)
    clash.network.ports.append(
        spec.Port(guest=5432, host=clash.network.host_for("web"), name="clash")
    )
    try:
        clash.validate()
        check("publishing one host port twice is rejected", False, "validate accepted it")
    except VmhubError as exc:
        check("publishing one host port twice is rejected", "published twice" in str(exc), str(exc))
    bogus = registry.load_spec(pvm)
    bogus.network.ports.append(spec.Port(guest=9999, host=16001, role="telnet"))
    try:
        bogus.validate()
        check("an unknown role is rejected", False, "validate accepted it")
    except VmhubError as exc:
        check("an unknown role is rejected", "unknown role" in str(exc), str(exc))
    dup_role = registry.load_spec(pvm)
    dup_role.network.ports.append(spec.Port(guest=2222, host=16002, role="ssh"))
    try:
        dup_role.validate()
        check("two entries claiming one role are rejected", False, "validate accepted it")
    except VmhubError as exc:
        check("two entries claiming one role are rejected", "claim the ssh role" in str(exc), str(exc))

    # A user port that collides has to be moved like any other, and taking
    # the port away must not quietly clear the entry.
    thief = f"{VM}-thief"
    lifecycle.create(thief, blueprint="alpine")
    tspec = registry.load_spec(thief)
    tspec.network.ports.append(spec.Port(guest=5432, host=16000, name="Stolen"))
    registry.save_spec(tspec)
    pspec = registry.load_spec(pvm)
    pspec.network.ports.append(spec.Port(guest=5432, host=16000, name="Postgres"))
    pspec.network.guest_ports = sorted({*pspec.network.guest_ports, 5432})
    registry.save_spec(pspec)
    changes = ports.ensure_for(pvm)
    check("a clashing user port is reassigned too",
          any("Postgres 16000 ->" in c for c in changes), str(changes))
    after = registry.load_spec(pvm).network
    moved_back = [p for p in after.ports if p.name == "Postgres"]
    check("the guest port is unchanged by the move",
          bool(moved_back) and moved_back[0].guest == 5432, str(moved_back))
    check("the roles were left alone", after.host_for("web") > 0 and after.host_for("ssh") > 0)
    lifecycle.remove(thief, progress=None)
    lifecycle.remove(pvm, progress=None)

    section("what vmhub runs, and what it reports")
    # An image reference is not "everything before the first colon". A
    # registry carries a port, and splitting there produced a repository
    # and a tag that no registry has ever heard of.
    for ref, want in (
        ("docker.io/library/alpine:3.19", ("docker.io/library/alpine", "3.19")),
        ("alpine", ("alpine", "")),
        ("alpine:3.19", ("alpine", "3.19")),
        ("registry.example:5000/qemu", ("registry.example:5000/qemu", "")),
        ("localhost:5000/qemu:1.2", ("localhost:5000/qemu", "1.2")),
        ("quay.io/qemu@sha256:" + "a" * 64, ("quay.io/qemu@sha256:" + "a" * 64, "")),
    ):
        check(f"image {ref} splits correctly", spec.split_image_ref(ref) == want,
              str(spec.split_image_ref(ref)))

    imvm = f"{VM}-image"
    lifecycle.create(imvm, blueprint="alpine", image="registry.example:5000/qemu:1.2")
    imspec = registry.load_spec(imvm)
    check("a ported registry survives into the spec",
          imspec.image.repository == "registry.example:5000/qemu", imspec.image.repository)
    check("and its tag is the tag", imspec.image.tag == "1.2", imspec.image.tag)
    check("the reference round-trips", imspec.image.ref == "registry.example:5000/qemu:1.2",
          imspec.image.ref)

    # resources.kvm=false reached the spec and was reported in the UI, but
    # run_argv passed /dev/kvm either way: QEMU was told KVM=N and ignored
    # the device, while the container still had it.
    kvm_vm = f"{VM}-nokvm"
    lifecycle.create(kvm_vm, blueprint="alpine")
    kspec = registry.load_spec(kvm_vm)
    kspec.resources.kvm = False
    registry.save_spec(kspec)
    argv = podman.run_argv(registry.load_spec(kvm_vm), "uuid", "mac", None)
    check("kvm=false keeps /dev/kvm out of the container",
          "/dev/kvm" not in argv, str(argv[:14]))
    kspec.resources.kvm = True
    registry.save_spec(kspec)
    argv = podman.run_argv(registry.load_spec(kvm_vm), "uuid", "mac", None)
    check("kvm=true still passes it",
          "/dev/kvm" in argv, str(argv[:14]))

    # vmctl stop printed the failure in red and exited 0, so
    # `vmctl stop x && vmctl rm x` deleted a VM that was still running.
    # A stop that cannot happen has to be visible to the shell.
    import argparse as _argparse

    stopvm = f"{VM}-stoprc"
    lifecycle.create(stopvm, blueprint="alpine")

    def run_stop(names, mode):
        ns = _argparse.Namespace(names=names, force=False, mode=mode, quiet=True)
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = cli.cmd_stop(ns, cli.Out())
        return rc, buf.getvalue()

    # Built by hand: argparse rejects an unknown mode before cmd_stop ever
    # sees it, and lifecycle.stop is what has to raise.
    rc, text = run_stop([stopvm], "nonsense")
    check("vmctl stop exits non-zero when a VM does not stop", rc != 0, f"rc={rc}")
    check("and says which one", stopvm in text, text.strip())
    lifecycle.start(stopvm)
    rc, text = run_stop([stopvm], "force")
    check("vmctl stop exits 0 when it worked", rc == 0, f"rc={rc} {text.strip()}")
    check("and the VM really is stopped", podman.state(stopvm) != "running",
          podman.state(stopvm))

    lifecycle.remove(stopvm)
    lifecycle.remove(imvm)
    lifecycle.remove(kvm_vm)

    section("cleanup")
    for name in (
        f"{VM}-stop", f"{VM}-rival", f"{VM}-stale", f"{VM}-clone2",
        f"{VM}-power", f"{VM}-tpl", f"{VM}-kid", f"{VM}-ports", f"{VM}-thief",
        f"{VM}-secret", f"{VM}-fresh", f"{VM}-chosen", f"{VM}-roundtrip",
        f"{VM}-finishinstall",
        f"{VM}-clone", f"{VM}-linked-import", f"{VM}-libvirt",
        f"{VM}-plain", f"{VM}-full-from-plain", imported, VM,
    ):
        if not registry.exists(name):
            continue
        try:
            lifecycle.stop(name, force=True)
        except VmhubError as exc:
            print(f"  (stop {name}: {exc})")
        lifecycle.remove(name)
    check("all test VMs removed", not registry.exists(VM))
    stale = [
        b for b in paths.backup_dir().glob("*.vmhub.tar.gz")
        if b.name.startswith(VM) or b.name.startswith("sweepvm")
    ]
    for bundle in stale:
        bundle.unlink(missing_ok=True)
    check("test bundles cleaned up",
          not [b for b in paths.backup_dir().glob("*.vmhub.tar.gz")
               if b.name.startswith(VM) or b.name.startswith("sweepvm")],
          str([b.name for b in stale]))
    leftovers = [m.name for m in registry.iter_metas() if m.name.startswith("vmhub-selftest")]
    check("no leftovers on disk", not leftovers, str(leftovers))
    vanished = sorted(preexisting - set(registry.all_names()))
    check("every VM that existed before this run still exists",
          not vanished,
          f"the test run removed {vanished}")

    print()
    if failed:
        print(f"\033[31m{len(failed)} check(s) failed:\033[0m " + ", ".join(failed))
        return 1
    print(f"\033[32mall {passed} checks passed\033[0m")
    return 0


if __name__ == "__main__":
    sys.exit(main())
