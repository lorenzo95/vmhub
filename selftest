    section("gui source invariants")
    ui_dir = paths.project_root() / "src" / "vmhub" / "ui"

    def gui_methods(path: Path):
        text = path.read_text()
        tree = ast.parse(text)
        for node in ast.walk(tree):
            if isinstance(node, ast.ClassDef):
                for sub in node.body:
                    if isinstance(sub, ast.FunctionDef):
                        yield node.name, sub.name, ast.get_source_segment(text, sub) or ""

    # A duplicate method silently shadows the earlier one, and a handler sweep only
    # ever calls the survivor. This is how a dead Clone button hid for so long.
    duplicates: list[str] = []
    for path in sorted(ui_dir.glob("*.py")):
        for node in ast.walk(ast.parse(path.read_text())):
            if not isinstance(node, ast.ClassDef):
                continue
            seen: dict[str, list[int]] = {}
            for sub in node.body:
                if isinstance(sub, ast.FunctionDef):
                    seen.setdefault(sub.name, []).append(sub.lineno)
            for name, lines in seen.items():
                if len(lines) > 1:
                    duplicates.append(f"{path.name}:{node.name}.{name}@{lines}")
    check("no duplicate GUI method definitions", not duplicates, str(duplicates))

    # A popover with no parent is not a cosmetic problem. popup() realises it
    # outside the widget hierarchy, gets no surface, and GTK4 segfaults --
    # right-clicking a VM in the sidebar used to take the whole app down.
    #
    # Asked of the AST rather than the text: the word "Popover" in a comment is
    # prose about popovers, not a popover, and matching it would flag this
    # very file for explaining the bug.
    orphan_popovers: list[str] = []
    for path in sorted(ui_dir.glob("*.py")):
        text = path.read_text()
        for node in ast.walk(ast.parse(text)):
            if not isinstance(node, ast.FunctionDef):
                continue
            mentions = any(
                (isinstance(n, ast.Attribute) and "Popover" in n.attr)
                or (isinstance(n, ast.Name) and "Popover" in n.id)
                for n in ast.walk(node)
            )
            if not mentions:
                continue
            seg = ast.get_source_segment(text, node) or ""
            if not re.search(r"\.(set_parent|set_parent_widget)\s*\(", seg):
                orphan_popovers.append(f"{path.name}:{node.name}")
    check("every popover is given a parent before it is popped up",
          not orphan_popovers, str(orphan_popovers))

    # Gio.Menu sections are opaque to PyGObject, so what the sidebar's
