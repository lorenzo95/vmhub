          not list(paths.vm_dir(atomic_vm).glob("*.tmp.*")),
          str(list(paths.vm_dir(atomic_vm).iterdir())))

    # Simulate a write that dies after the file is already truncated -- a full
    # disk, a crash, a second writer. pathlib opens the target for writing
    # before it has any bytes, so a plain write leaves a file that is neither
    # the old spec nor the new one. This is the shape a real vm.toml turned
    # up in: a duplicated key and an orphaned value fragment.
    real_write_text = Path.write_text

    def dying_write_text(self, data, *a, **k):
        with open(self, "w") as handle:
            handle.write(data[: len(data) // 2])
        raise OSError("simulated: died mid-write")

    try:
        Path.write_text = dying_write_text  # type: ignore[method-assign]
        spec.save(atomic_spec, atomic_path)
    except OSError:
        pass
    finally:
        Path.write_text = real_write_text  # type: ignore[method-assign]

