#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
# The checkout this script lives in *is* the project root, so name it rather
# than leaving it to be discovered by walking up from the working directory:
# a desktop entry runs us in the user's home, and discovery only walks
# upward, so from /home/you it can never reach /home/you/vmhub.
#
# ${VMHUB_HOME:-$HERE}, not $HERE: a desktop session has no VMHUB_HOME and
# gets this checkout, which is what fixes the menu entry. An explicit
# VMHUB_HOME still wins, because the README documents it as the way to point
# vmhub at another checkout -- and hardcoding it made that a no-op.
export VMHUB_HOME="${VMHUB_HOME:-$HERE}"
exec python3 -m vmhub.ui.app "$@"
