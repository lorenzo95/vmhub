#!/usr/bin/env python3
"""GUI smoke test: exercises every handler, action and widget helper headlessly.

Run with a display available, e.g. under Xvfb:
    xvfb-run -a ./guicheck
"""

from __future__ import annotations

import inspect
import os
import re
import shutil
import tempfile
import time
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

# Never spawn a real client or browser from the handler sweep.
os.environ["VMHUB_NO_LAUNCH"] = "1"

# Use a distinct bus name. The bus name is per D-Bus session, not per display,
# so sharing the GUI's id would make this run silently remote and exit at once
# whenever vmhub is already open.
os.environ["VMHUB_APP_ID"] = "dev.vmhub.GUI.Check"

# The sweep exercises the preferences dialog, which writes. Point the
# app-wide defaults at a scratch file so this run cannot touch the real one:
# a test that edits ~/.config/vmhub/settings.toml is a test that destroys it.
os.environ["VMHUB_CONFIG"] = str(
    Path(tempfile.mkdtemp(prefix="vmhub-gc-cfg-")) / "settings.toml"
)

if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
    print("guicheck: no DISPLAY or WAYLAND_DISPLAY set; skipping.")
    print("          run it under Xvfb, e.g.  xvfb-run -a ./guicheck")
    sys.exit(0)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

from vmhub import (  # noqa: E402
    iso as isomod,
    lifecycle,
    paths,
    podman,
    ports,
    registry,
    spec,
)
from vmhub.ui import newvm, widgets, workers  # noqa: E402
from vmhub.ui.app import VmhubApp  # noqa: E402
from vmhub import settings as settings_mod  # noqa: E402
from vmhub.ui.pane import VmPane  # noqa: E402

VM = "vmhub-guicheck"
failures: list[tuple[str, str]] = []
exercised: list[str] = []


# Handlers that act on EVERY VM, not just the one under test. Exercising them
# here would start and stop the user's real machines, which is how this sweep
# was silently mutating state it had no business touching. Their logic is
# covered by the backend selftest against throwaway VMs.
DESTRUCTIVE = {"_on_start_all", "_on_stop_all", "_on_restore", "_on_prune"}

# Handlers that wreck the window itself rather than a VM. Swept in name order,
# _on_close stops every pane's log timer and latches window._closing, which
# quietly switched off the async refresh handling for the rest of the run. It
# is exercised once, explicitly, at the end of the probe instead.
WINDOW_FATAL = {"_on_close"}


def sweep(obj, label: str) -> None:
    for name in sorted(dir(type(obj))):
        if not name.startswith("_on") or name in DESTRUCTIVE or name in WINDOW_FATAL:
            continue
        fn = getattr(obj, name, None)
        if not callable(fn):
            continue
        required = [
            p
            for p in inspect.signature(fn).parameters.values()
            if p.default is inspect.Parameter.empty
            and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)
        ]
        # slot and name already had real values. The port-table actions take
        # a role or a Port rather than a button, so give them one: sweeping
        # them with None would only prove the guard, not the action.
        args = [
            {
                "slot": isomod.INSTALL_SLOT,
                "name": "guicheck-name",
                "role": "rdp",
                "port": spec.Port(guest=5432, host=15999, name="guicheck"),
            }.get(p.name)
            for p in required
        ]
        signature = f"{label}.{name}({', '.join(p.name for p in required)})"
        try:
            fn(*args)
            exercised.append(signature)
        except Exception as exc:  # noqa: BLE001
            failures.append((signature, f"{type(exc).__name__}: {exc}"))
            print(f"  \033[31mFAIL\033[0m  {signature}\n        {type(exc).__name__}: {exc}")


def check(label: str, fn) -> None:
    try:
        fn()
        exercised.append(label)
    except Exception as exc:  # noqa: BLE001
        failures.append((label, f"{type(exc).__name__}: {exc}"))
        print(f"  \033[31mFAIL\033[0m  {label}: {type(exc).__name__}: {exc}")


def probe(app) -> bool:
    try:
        _probe(app)
    except Exception as exc:  # noqa: BLE001
        failures.append(("probe", f"{type(exc).__name__}: {exc}"))
        print(f"  \033[31mFAIL\033[0m  probe aborted: {type(exc).__name__}: {exc}")
    finally:
        try:
            _cleanup()
        except Exception as exc:  # noqa: BLE001
            print(f"  cleanup: {type(exc).__name__}: {exc}")
        app.quit()
    return False


def pump_until(condition, timeout: float = 8.0) -> bool:
    """Run the main loop until condition() holds.

    iteration(False) does not reliably dispatch an idle source queued by another
    thread, which made an earlier version of this check report a false failure.
    A 25 ms one-shot source bounds each blocking iteration.
    """
    main = GLib.MainContext.default()
    deadline = time.time() + timeout
    while time.time() < deadline:
        if condition():
            return True
        GLib.timeout_add(25, lambda: False)
        main.iteration(True)
    return condition()


def settle_dialog() -> None:
    """Let GTK deliver the change signal an entry just emitted."""
    pump_until(lambda: False, 0.25)


# Every VM either harness mints is throwaway by construction.
HARNESS_PREFIXES = ("vmhub-guicheck", "vmhub-selftest", "sweepvm")


def _cleanup() -> None:
    """Sweep what an earlier harness run left behind.

    A leftover is not the user's, and letting one sit here makes it look like
    one: the sweep check at the end of the run would blame the GUI for it
    going missing.
    """
    import shutil

    for meta in list(registry.iter_metas()):
        if not meta.name.startswith(HARNESS_PREFIXES):
            continue
        # A powered-on harness VM belongs to another process: the backend
        # selftest runs separately and may be using it right now. Leaving it
        # alone is correct; pulling it out from under that run is not.
        try:
            if lifecycle.status(meta.name).powered:
                continue
        except Exception:
            pass
        try:
            lifecycle.stop(meta.name, force=True)
        except Exception:
            pass
        shutil.rmtree(paths.vm_dir(meta.name), ignore_errors=True)
    for bundle in paths.backup_dir().glob("*.vmhub.tar.gz"):
        if bundle.name.startswith(HARNESS_PREFIXES):
            bundle.unlink(missing_ok=True)


def rebuild_pane(window, name: str) -> None:
    """Drop a cached pane so the next select_vm builds a fresh one.

    A pane built once and kept for the whole run is not a fair subject for the
    log-timer check: anything earlier that closed it leaves it looking exactly
    like a pane whose timer was stopped by switching away.
    """
    old = window.panes.pop(name, None)
    if old is not None:
        old.close()
        child = window.content.get_child_by_name(name)
        if child is not None:
            window.content.remove(child)


def _probe(app) -> None:
    _cleanup()
    window = app.window
    # This sweep calls every handler in the GUI, on real widgets, for real.
    # Whatever VMs exist right now belong to the user: remember them so the
    # end of the run can prove none of them was removed by the sweep.
    # Only the user's VMs belong in this set. _cleanup() removed the harness
    # leftovers that were not running; anything still carrying a harness name
    # belongs to another run and is not evidence about this sweep.
    preexisting = {
        name
        for name in registry.all_names()
        if not name.startswith(HARNESS_PREFIXES)
    }

    def settle() -> None:
        """Render a snapshot synchronously; the real refresh() is async."""
        window._apply_statuses(lifecycle.list_vms())

    lifecycle.create(VM, blueprint="alpine")
    settle()
    if VM not in window.order:
        print("  \033[31mFAIL\033[0m  could not create the test VM")
        app.quit()
        return False
    window.select_vm(VM)
    pane = window.panes[VM]

    sweep(window, "window")
    sweep(pane, "pane")
    sweep(newvm.NewVmDialog(window), "newvm")

    for name in ("refresh", "doctor", "restore"):
        action = window.lookup_action(name)
        if action is None:
            failures.append((f"action:{name}", "not registered"))
            print(f"  \033[31mFAIL\033[0m  action:{name} is not registered")
            continue
        check(f"action:{name}", lambda a=action: a.activate(None))

    status = window.statuses[VM]
    check("filter_store", lambda: widgets.filter_store("x", ["*.iso"]))
    check("key_value_grid", lambda: widgets.key_value_grid([("a", "b")]))
    check("section", lambda: widgets.section("h"))
    check("copy_row", lambda: widgets.copy_row("text"))
    check("StateDot", lambda: widgets.StateDot("running"))
    check("VmRow", lambda: widgets.VmRow(status))
    check("scroll", lambda: widgets.scroll(Gtk.Label(label="x")))

    broken = "vmhub-guicheck-broken"
    lifecycle.create(broken, blueprint="alpine")
    paths.spec_path(broken).unlink()
    settle()
    if broken in window.order:
        window.select_vm(broken)
        for _ in range(3):
            settle()
        exercised.append("missing vm.toml does not break the UI")
        pane = window.panes.get(broken)
        if pane and not (pane.error_label.get_text() or "").strip():
            failures.append(("missing vm.toml error is shown", "error label was empty"))
            print("  \033[31mFAIL\033[0m  missing vm.toml: error label was empty")
    else:
        failures.append(("missing vm.toml", "VM vanished from the list"))
        print("  \033[31mFAIL\033[0m  missing vm.toml: VM vanished from the list")
    import shutil

    shutil.rmtree(paths.vm_dir(broken), ignore_errors=True)
    settle()
    if broken in window.panes:
        failures.append(("pane not pruned", broken))
        print(f"  \033[31mFAIL\033[0m  pane for the removed VM {broken!r} was not pruned")
    else:
        exercised.append("panes are pruned when a VM disappears")
        print("  \033[32mPASS\033[0m  pane pruned when the VM disappeared")

    # ---- a registered action must actually CALL its handler ----
    # Every win.* item was registered and resolvable and raised
    # "TypeError: 'NoneType' object is not callable" on click, because the
    # lambda was written for a one-argument signal and "activate" passes two.
    # Checking that an action is registered proves nothing about this, which
    # is why the existing "actions are registered" checks all passed while
    # Preferences, Doctor, Restore and the overflow refresh were dead.
    import gi as _gi
    from gi.repository import GLib as _GLib
    fired = []
    originals = {}
    # Record the ACTION name, not the attribute name: the guard below compares
    # against win.<name>, and logging "_on_prefs" against "prefs" read three
    # working handlers as missing.
    for _attr, _action_name in (
        ("refresh", "refresh"),
        ("_on_doctor", "doctor"),
        ("_on_restore", "restore"),
        ("_on_prefs", "prefs"),
    ):
        originals[_attr] = getattr(window, _attr)
        setattr(window, _attr, (lambda a: (lambda *_x: fired.append(a)))(_action_name))
    poll_tag = getattr(window, "_refresh_tag", 0)
    if poll_tag:
        _GLib.source_remove(poll_tag)   # the 4s poll would fake a "refresh"
        window._refresh_tag = 0
    try:
        window._install_win_actions()
        settle()
        for _name in ("refresh", "doctor", "restore", "prefs"):
            window.win_actions.lookup_action(_name).activate(None)
            settle()
        never_fired = [n for n in ("refresh", "doctor", "restore", "prefs")
                       if n not in fired]
    finally:
        for _attr, _fn in originals.items():
            setattr(window, _attr, _fn)
        window._install_win_actions()
    if never_fired:
        failures.append((
            "a win.* action did not call its handler",
            f"never fired: {never_fired}; fired: {fired}",
        ))
        print(f"  \033[31mFAIL\033[0m  win.* handlers never ran: {never_fired}")
    else:
        exercised.append("every win.* action calls its handler")
        print("  \033[32mPASS\033[0m  all four win.* actions called their handler")

    # ---- a dialog that can be opened must actually appear ----
    # Preferences was wired into the menu, not greyed out, and never
    # presented: get_visible() and get_mapped() were both False, so clicking
    # it did nothing at all.
    from vmhub.ui.prefs import PreferencesDialog
    prefs = PreferencesDialog(window)
    settle()
    if prefs.get_visible():
        exercised.append("the Preferences dialog actually appears")
        print("  \033[32mPASS\033[0m  Preferences dialog appears when opened")
    else:
        failures.append(("Preferences dialog never appears", "get_visible() is False"))
        print("  \033[31mFAIL\033[0m  Preferences dialog is built but never shown")
    prefs.close()

    # ---- a control disabled by a transient error must come back ----
    # update() greys out Start when a VM's spec is unreadable, and restored
    # every other control it disables -- except this one, so a VM that tripped
    # the error once left Start dead for the rest of the session.
    import dataclasses
    revert_vm = f"{VM}-recover"
    lifecycle.create(revert_vm, blueprint="alpine")
    settle()
    recover_pane = VmPane(window, revert_vm)
    good = lifecycle.status(revert_vm)
    recover_pane.update(dataclasses.replace(good, exists=False, errors=["torn vm.toml"]))
    # get_sensitive() is True when ENABLED, so negate it to mean "greyed out".
    greyed = not recover_pane.power_button.get_sensitive()
    recover_pane.update(good)
    recovered = recover_pane.power_button.get_sensitive()
    if greyed and recovered:
        exercised.append("Start comes back after a transient spec error")
        print("  \033[32mPASS\033[0m  Start is restored after the VM becomes readable")
    else:
        failures.append((
            "Start stays disabled after recovery",
            f"disabled={not greyed}, re-enabled={recovered}",
        ))
        print(f"  \033[31mFAIL\033[0m  Start never re-enabled "
              f"(disabled={not greyed}, re-enabled={recovered})")
    recover_pane.close()
    lifecycle.remove(revert_vm, progress=None)
    settle()

    # ---- a pane that is not on screen must still refresh ----
    # _apply_statuses refreshed only self.current, so a VM whose spec changed
    # while another one was selected kept showing the old numbers until you
    # switched to it. Selecting was the only other thing that updated a pane,
    # which is why it looked like the page needed a tab switch to update.
    otherpane = f"{VM}-otherpane"
    lifecycle.create(otherpane, blueprint="alpine")
    window.select_vm(otherpane)
    settle()
    window.select_vm(VM)
    settle()
    sibling = window.panes.get(otherpane)

    def _rendered_host(pane):
        # GTK4 has no get_children(): it is get_first_child()/get_next_sibling().
        if pane is None:
            return "(no pane)"
        row = pane.roles_box.get_first_child()
        while row is not None:
            child = row.get_first_child()
            while child is not None:
                if isinstance(child, Gtk.Label) and child.get_text().startswith("host "):
                    return child.get_text()
                child = child.get_next_sibling()
            row = row.get_next_sibling()
        return "(no host line)"

    ospec = registry.load_spec(otherpane)
    new_host = ospec.network.by_role("web").host + 1
    ospec.network.set_role("web", 8006, new_host)
    registry.save_spec(ospec)
    shown = _rendered_host(sibling)
    window._apply_statuses(lifecycle.list_vms())
    settle()
    after = _rendered_host(sibling)
    if str(new_host) in after:
        exercised.append("an unselected VM's pane refreshes on its own")
        print(f"  \033[32mPASS\033[0m  unselected pane refreshed {shown!r} -> {after!r}")
    else:
        failures.append((
            "unselected pane stays stale",
            f"vm.toml says {new_host}, pane shows {after!r}",
        ))
        print(f"  \033[31mFAIL\033[0m  unselected pane stale: shows {after!r}, "
              f"vm.toml says {new_host}")
    lifecycle.remove(otherpane, progress=None)
    settle()

    # ---- sidebar context menu and accelerators ----
    # These live in the "row" action group, not on the window. Checking the
    # window used to pass while every item in the menu was greyed out: the
    # window did have the actions, just not anywhere the popover could see.
    row_group = getattr(window, "row_actions", None)
    missing_actions = [
        name for name in ("console", "start", "stop", "clone", "export", "delete")
        if row_group is None or row_group.lookup_action(name) is None
    ]
    if missing_actions:
        failures.append(("row actions missing", str(missing_actions)))
        print(f"  \033[31mFAIL\033[0m  sidebar actions not registered: {missing_actions}")
    else:
        exercised.append("sidebar context-menu actions are registered")
        print("  \033[32mPASS\033[0m  sidebar context-menu actions registered")

    accels = set(window.get_application().get_accels_for_action("app.new-vm"))
    # GTK reports <primary> back as <Control> on Linux.
    bound = {"<primary>n", "<Control>n"} & accels
    if not bound:
        failures.append(("Ctrl+N not bound", str(accels)))
        print(f"  \033[31mFAIL\033[0m  Ctrl+N is not bound for app.new-vm ({accels})")
    else:
        exercised.append("Ctrl+N is bound")
        print("  \033[32mPASS\033[0m  Ctrl+N is bound to New VM")

    # ---- dialogs that were once constructed and never shown ----
    opened: list = []
    original_present = widgets.TextPrompt.present
    widgets.TextPrompt.present = lambda self: (opened.append(self), original_present(self))[1]
    try:
        window.select_vm(VM)
        before = len(opened)
        window.panes[VM]._on_clone(None)
        clone_opened = len(opened) > before

        # The dialog must actually have a name field. It builds one for the
        # linked/full choice via extra=, and TextPrompt treats any extra= as
        # "this caller brings its own fields" -- so with nothing saying
        # otherwise, no entry was constructed and Clone submitted an empty
        # name, which came out as "invalid VM name: ''" with nothing on screen
        # to type into.
        clone_dialog = opened[-1] if opened else None
        clone_entry = getattr(clone_dialog, "entry", None)
        if clone_entry is not None and clone_entry.get_text() == f"{VM}-copy":
            exercised.append("the Clone dialog has a prefilled name field")
            print("  \033[32mPASS\033[0m  Clone dialog has a prefilled name field")
        else:
            shown = clone_entry.get_text() if clone_entry is not None else "no entry at all"
            failures.append(("Clone dialog has no name field", shown))
            print(f"  \033[31mFAIL\033[0m  Clone dialog name field: {shown!r}")

        # give the VM an RDP port but no account, so _on_remmina takes the prompt path
        rdp_spec = registry.load_spec(VM)
        rdp_spec.network.guest_ports = [22, 3389]
        rdp_spec.network.set_role("rdp", 3389, ports.allocate("rdp"))
        rdp_spec.media.rdp_user = ""
        registry.save_spec(rdp_spec)
        settle()
        window.select_vm(VM)
        before = len(opened)
        window.panes[VM]._on_remmina(None)
        remmina_opened = len(opened) > before

        # The two "Change…" actions on the port table open a prompt asking
        # for the new host port. Drive them the way a click would.
        before = len(opened)
        window.panes[VM]._on_change_role("rdp")
        change_role_opened = len(opened) > before
        before = len(opened)
        window.panes[VM]._on_change_port(spec.Port(guest=5432, host=15999, name="guicheck"))
        change_port_opened = len(opened) > before
    finally:
        widgets.TextPrompt.present = original_present
        for dialog in opened:
            dialog.close()

    if not clone_opened:
        failures.append(("clone dialog not shown", "the Clone button does nothing"))
        print("  \033[31mFAIL\033[0m  Clone… did not open a dialog")
    else:
        exercised.append("the Clone dialog is shown")
        print("  \033[32mPASS\033[0m  Clone… opens its dialog")

    if not remmina_opened:
        failures.append(("remmina prompt not shown", "the account prompt does nothing"))
        print("  \033[31mFAIL\033[0m  Connect with Remmina did not open the account prompt")
    else:
        exercised.append("the Remmina account prompt is shown")
        print("  \033[32mPASS\033[0m  Connect with Remmina opens the account prompt")

    for opened_ok, label, detail in (
        (change_role_opened, "the RDP row's Change… opens its prompt",
         "the port table's role prompt does nothing"),
        (change_port_opened, "a custom port's Change… opens its prompt",
         "the port table's entry prompt does nothing"),
    ):
        if not opened_ok:
            failures.append((label, detail))
            print(f"  \033[31mFAIL\033[0m  {detail}")
        else:
            exercised.append(label)
            print(f"  \033[32mPASS\033[0m  {label}")

    def _walk(widget):
        yield widget
        child = widget.get_first_child()
        while child is not None:
            yield from _walk(child)
            child = child.get_next_sibling()

    # The ports table and the details grid moved off Hardware and Console onto
    # tabs of their own. They used to share one tab called "Info", which named
    # neither half and made port forwarding mean scrolling past six read-only
    # fields; they are now "Ports" and "Details".
    pane = window.panes[VM]
    titles = [
        pane.notebook.get_tab_label(pane.notebook.get_nth_page(i)).get_text()
        for i in range(pane.notebook.get_n_pages())
    ]
    missing = [t for t in ("Ports", "Details") if t not in titles]
    if missing:
        failures.append((f"{missing} tab missing", str(titles)))
        print(f"  \033[31mFAIL\033[0m  no {missing} tab; tabs are {titles}")
    else:
        exercised.append("the Ports and Details tabs exist")
        print("  \033[32mPASS\033[0m  the Ports and Details tabs exist")
    if "Info" in titles:
        failures.append(("Info tab still there", str(titles)))
        print("  \033[31mFAIL\033[0m  the combined Info tab is still present")
    else:
        exercised.append("the combined Info tab is gone")
        print("  \033[32mPASS\033[0m  the combined Info tab is gone")
    # The Actions tab is gone; what it held now lives where it is used.
    if "Actions" in titles:
        failures.append(("Actions tab still there", str(titles)))
        print("  \033[31mFAIL\033[0m  the Actions tab is still present")
    else:
        exercised.append("the Actions tab is gone")
        print("  \033[32mPASS\033[0m  the Actions tab is gone")
    hardware = (
        {
            w.get_label()
            for w in _walk(pane.notebook.get_nth_page(titles.index("Hardware")))
            if isinstance(w, Gtk.Button)
        }
        if "Hardware" in titles
        else set()
    )
    leaked = {"Clone\u2026", "Mark as template", "Export bundle\u2026"} & hardware
    if leaked:
        # Any of these on Hardware means the copies block was left behind.
        found = sorted(str(label) for label in leaked)
        failures.append(("Hardware kept a copy control", str(found)))
        print(f"  \033[31mFAIL\033[0m  Hardware still has {found}")
    else:
        exercised.append("Hardware no longer carries the copies block")
        print("  \033[32mPASS\033[0m  Hardware no longer carries the copies block")

    # A notice is a row of its own, and it is text only. The action it describes
    # used to hang off the notice itself, which meant the button existed only
    # while that particular notice did -- so on a VM with nothing to finish,
    # the Finish install button simply was not there, with nothing to say so.
    # It is a permanent control in the Install media section now, which says
    # why it is unavailable.
    plain = pane._notice_row(lifecycle.Notice("just so you know"))
    actioned = pane._notice_row(lifecycle.Notice("fixable", action="finish-install"))
    finish_button = getattr(pane, "finish_install_button", None)
    if plain.get_first_child().get_next_sibling() is not None:
        failures.append(("notice row", "a notice grew a button"))
        print("  \033[31mFAIL\033[0m  a notice grew a button")
    elif actioned.get_first_child().get_next_sibling() is not None:
        failures.append(("notice row", "an actionable notice grew a button again"))
        print("  \033[31mFAIL\033[0m  an actionable notice grew a button again")
    elif finish_button is None:
        failures.append(("finish install button", "the pane has no such button"))
        print("  \033[31mFAIL\033[0m  the pane has no Finish install button")
    else:
        # The invariant is not "always enabled" -- a VM with nothing to detach
        # must not offer the action. It is that the button agrees with the
        # status it is describing, in both directions.
        wanted = bool(getattr(pane.status, "finish_install_needed", False))
        if finish_button.get_sensitive() != wanted:
            failures.append((
                "finish install button",
                f"sensitive={finish_button.get_sensitive()} but "
                f"finish_install_needed={wanted}",
            ))
            print(
                "  \033[31mFAIL\033[0m  Finish install is "
                f"{'enabled' if finish_button.get_sensitive() else 'disabled'} "
                f"but finish_install_needed={wanted}"
            )
        else:
            exercised.append("Finish install agrees with the VM's actual state")
            print(
                "  \033[32mPASS\033[0m  Finish install is a permanent control "
                f"that is {'enabled' if wanted else 'disabled'} exactly when "
                "there is something to finish"
            )

    # The app-wide defaults are only half a feature if they can only be reached by
    # hand-editing TOML. Build the real dialog and save through it.
    from vmhub.ui.prefs import PreferencesDialog  # noqa: E402

    prefs = PreferencesDialog(window)
    try:
        entries = prefs.entries
        if set(entries) != set(settings_mod.FIELDS):
            failures.append((
                "preferences dialog",
                f"offers {sorted(entries)}, expected {sorted(settings_mod.FIELDS)}",
            ))
            print("  \033[31mFAIL\033[0m  the preferences dialog does not offer every setting")
        else:
            for key in entries:
                entries[key].set_text(f"probe-{key}")
            prefs._on_save(None)
            saved = settings_mod.load()
            if all(saved.get(key) == f"probe-{key}" for key in entries):
                exercised.append("the preferences dialog saves the app-wide defaults")
                print(
                    "  \033[32mPASS\033[0m  the preferences dialog saves every "
                    "app-wide default"
                )
            else:
                failures.append(("preferences dialog", f"stored {saved}"))
                print("  \033[31mFAIL\033[0m  the preferences dialog did not save")
    finally:
        prefs.close()
        # Put the defaults back: the sweep must not leave the user's settings
        # pointing at a probe value.
        settings_mod.save({key: "" for key in settings_mod.FIELDS})

    # A pane refresh pushes values into the RDP entries with set_text(), which
    # emits "changed" -- the signal those handlers save on. Without a guard,
    # every refresh rewrote the VM's vm.toml. Two of those writes landing at
    # once tore the file into invalid TOML, which is how a real VM was
    # damaged.
    #
    # The damage was a race, so comparing file contents does not reproduce
    # it: one sequential save per refresh is merely wrong, not visibly torn.
    # Assert the thing that actually must not happen instead -- a refresh
    # must not ask to save anything.
    victim = f"{VM}-specsafe"
    lifecycle.create(victim, blueprint="alpine")
    window.select_vm(VM)
    saved_labels: list[str] = []
    real_run_task = widgets.run_task

    def spy(*call_args, **call_kwargs):
        saved_labels.append(str(call_kwargs.get("label", "")))
        return real_run_task(*call_args, **call_kwargs)

    widgets.run_task = spy
    try:
        window.select_vm(victim)
        window.select_vm(VM)
        window.select_vm(victim)
    finally:
        widgets.run_task = real_run_task
    writes = [label for label in saved_labels if "Saving" in label]
    if not writes:
        exercised.append("selecting a VM does not rewrite its spec")
        print(
            "  \033[32mPASS\033[0m  selecting a VM saves nothing; a refresh is "
            "not an edit"
        )
    else:
        failures.append((
            "pane refresh saved the spec",
            f"asked to save: {writes}",
        ))
        print(
            "  \033[31mFAIL\033[0m  selecting a VM asked to save its spec: "
            f"{writes}"
        )
    # ---- the internet checkbox must not save the spec it was built from ----
    # set_active() emits "toggled", so a refresh that populates the
    # checkbox from the spec also calls the handler that writes it.
    # That made selecting a VM rewrite vm.toml. The handler also has to
    # ignore a widget nobody has populated yet: a Gtk.CheckButton
    # defaults to False, and the sweep above reaches every _on* handler
    # with None for a parameter it has no value for, so the checkbox
    # could be read before it meant anything. That is what put
    # internet = false into a real VM's spec and put it on an
    # --internal network with no gateway.
    victim_spec = paths.spec_path(victim)
    before_refresh = victim_spec.read_text()
    fresh_pane = VmPane(window, victim)
    fresh_pane._refresh_ports()
    check(
        "refreshing the ports tab does not rewrite the spec",
        lambda: _assert(
            victim_spec.read_text() == before_refresh,
            "vm.toml changed on a plain refresh",
        ),
    )

    # The handler reached with a widget that was never populated, which
    # is what the sweep does. Must be a no-op on the spec.
    unsynced = Gtk.CheckButton()
    stale_pane = VmPane(window, victim)
    stale_pane._on_internet_toggled(unsynced)
    pump_until(lambda: False, 0.4)
    check(
        "the internet handler ignores an unsynced checkbox",
        lambda: _assert(
            victim_spec.read_text() == before_refresh,
            "an unpopulated checkbox changed the spec",
        ),
    )

    # And a real click, after a refresh has populated the widget, must
    # still reach the spec. Without this the two checks above would also
    # pass for a checkbox wired to nothing.
    real_pane = VmPane(window, victim)
    real_pane._refresh_ports()
    wanted = not registry.load_spec(victim).network.internet
    real_pane.internet_check.set_active(wanted)
    pump_until(
        lambda: registry.load_spec(victim).network.internet == wanted,
        4.0,
    )
    check(
        "clicking the internet checkbox saves the new value",
        lambda: _assert(
            registry.load_spec(victim).network.internet == wanted,
            f"spec says internet={registry.load_spec(victim).network.internet}, "
            f"clicked {wanted}",
        ),
    )
    # Put the victim back so the rest of the run, and the user, see it as
    # they left it.
    real_pane.internet_check.set_active(not wanted)
    pump_until(
        lambda: registry.load_spec(victim).network.internet == (not wanted),
        4.0,
    )
    fresh_pane.close()
    stale_pane.close()
    real_pane.close()

    window.select_vm(VM)
    window.panes.pop(victim, None)
    if registry.exists(victim):
        lifecycle.remove(victim)

    if not pane.ports_box.get_first_child() and not pane.roles_box.get_first_child():
        failures.append(("ports table empty", "the Info tab drew no port rows"))
        print("  \033[31mFAIL\033[0m  the Info tab drew no port rows")
    else:
        exercised.append("the port table is drawn")
        print("  \033[32mPASS\033[0m  the port table is drawn")

    # ---- a Copy button must copy what the row says now ----
    # It used to copy the string the button was built with. Every Console
    # row is created empty and filled in later, so all three of them put an
    # empty string on the clipboard no matter what they displayed.
    row = widgets.copy_row("before")
    widgets.set_copy_text(row, "after")
    row.get_first_child().get_next_sibling().emit("clicked")
    # Read it back through Gdk's async API. Asking another process for the
    # clipboard deadlocks here: xclip waits for the owner to answer, and the
    # owner is this process, whose main loop is busy waiting for xclip.
    clipboard = Gdk.Display.get_default().get_clipboard()
    pasted: list[str] = []
    clipboard.read_text_async(
        None, lambda _cb, res: pasted.append(clipboard.read_text_finish(res) or "")
    )
    pump_until(lambda: bool(pasted), timeout=4.0)
    got = pasted[0] if pasted else "<nothing came back>"
    if got == "after":
        exercised.append("a Copy button copies the row's current text")
        print("  \033[32mPASS\033[0m  a Copy button copies the row's current text")
    else:
        failures.append(("copy row", f"clipboard held {got!r}, expected 'after'"))
        print(f"  \033[31mFAIL\033[0m  Copy put {got!r} on the clipboard, expected 'after'")

    # ---- an unapplied edit must survive the status poll ----
    # The poll used to write the VM's values back into the controls every
    # four seconds, so a half-typed value was gone before Apply was pressed.
    pane.cpu_spin.set_value(7)
    settle()
    if pane.cpu_spin.get_value() == 7:
        exercised.append("an unapplied edit survives the poll")
        print("  \033[32mPASS\033[0m  an unapplied edit survives the poll")
    else:
        failures.append((
            "poll reverted an edit",
            f"vCPUs went back to {pane.cpu_spin.get_value()}",
        ))
        print(f"  \033[31mFAIL\033[0m  the poll reverted the edit to {pane.cpu_spin.get_value()}")

    # ---- progress messages must not keep the spinner alive ----
    strip = window.status_strip
    strip._active = 0
    strip.push("step one", transient=True)
    strip.push("step two", transient=True)
    strip.pop()
    if strip._active == 0 and not strip.spinner.get_visible():
        exercised.append("progress messages do not leak the spinner")
        print("  \033[32mPASS\033[0m  progress messages do not leak the spinner")
    else:
        failures.append((
            "spinner leaked",
            f"_active is {strip._active}, visible {strip.spinner.get_visible()}",
        ))
        print(f"  \033[31mFAIL\033[0m  the spinner leaked (_active {strip._active})")

    # ---- a hidden pane must keep watching ----
    # Returning False from the poll removes the timeout it is running in, and
    # only building the pane again would start another. So the log froze for
    # good the first time another tab was on screen -- which is every time.
    # This pane is deliberately not in the window, so it is never visible.
    hidden_pane = VmPane(window, VM)
    hidden_pane.set_visible(False)
    hidden = not hidden_pane.is_visible()
    keeps_timer = hidden_pane._poll_logs(hidden_pane._log_source)
    hidden_pane.close()
    if hidden and keeps_timer:
        exercised.append("a hidden pane keeps its log timer")
        print("  \033[32mPASS\033[0m  a hidden pane keeps its log timer")
    else:
        failures.append((
            "hidden log poll",
            f"pane visible {not hidden}, poll kept its timer {keeps_timer}",
        ))
        print(
            "  \033[31mFAIL\033[0m  a hidden pane stopped watching its log"
        )

    # ---- deleting a running VM must say so before promising anything ----
    # lifecycle.remove() refuses to delete a VM that is still running, so the old
    # dialog promised "This removes the VM, its container and its disk" and then
    # failed with a bare "Operation failed" alert. That is what makes a working
    # Delete look broken. Measured here on the real dialog objects.
    del_pane = VmPane(window, VM)
    try:
        del_pane.status = lifecycle.VmStatus(name=VM, powered=True)
        run_dialog, run_blocked = del_pane._delete_dialog()
        run_message = run_dialog.get_message() or ""
        run_detail = run_dialog.get_detail() or ""
        run_buttons = list(run_dialog.get_buttons() or [])

        del_pane.status = lifecycle.VmStatus(name=VM, powered=False)
        idle_dialog, idle_blocked = del_pane._delete_dialog()
        idle_message = idle_dialog.get_message() or ""
        idle_buttons = list(idle_dialog.get_buttons() or [])

        problems = []
        if not run_blocked:
            problems.append("a running VM was not treated as undeletable")
        if "running" not in run_message.lower():
            problems.append(f"the running dialog never says it is running: {run_message!r}")
        if "stop" not in run_detail.lower():
            problems.append("the running dialog does not say to stop it first")
        if "Delete" in run_buttons:
            problems.append(f"a running VM still offers a Delete button: {run_buttons}")
        if idle_blocked:
            problems.append("a stopped VM was wrongly treated as undeletable")
        if "Delete" not in idle_buttons:
            problems.append(f"a stopped VM offers no Delete button: {idle_buttons}")
        if VM not in idle_message:
            problems.append(f"the stopped dialog does not name the VM: {idle_message!r}")
        if problems:
            raise AssertionError("; ".join(problems))

        exercised.append("deleting a running VM says so up front, not after failing")
        print(
            "  \033[32mPASS\033[0m  deleting a running VM says so up front, "
            "not after failing"
        )
    finally:
        del_pane.close()

    # ---- Ports and Details are separate tabs; Clone lives with Snapshots ----
    # Measured by walking the real widget tree, because tab names alone would
    # pass even if everything still lived on one page.
    def descends(widget, ancestor) -> bool:
        node = widget
        while node is not None:
            if node is ancestor:
                return True
            node = node.get_parent()
        return False

    pane = window.panes[VM]
    settle()
    # get_tab_label_text() looks like it should take a page index, but PyGObject
    # binds it to a signature that wants a Gtk.Widget and raises "Expected
    # Gtk.Widget, but got int". Ask each page for its label widget instead, which
    # is the form the tab check above already uses.
    titles = [
        pane.notebook.get_tab_label(pane.notebook.get_nth_page(i)).get_text()
        for i in range(pane.notebook.get_n_pages())
    ]
    pages = {
        title: pane.notebook.get_nth_page(i) for i, title in enumerate(titles)
    }

    problems = []
    if "Ports" not in pages:
        problems.append(f"no Ports tab: {titles}")
    if "Details" not in pages:
        problems.append(f"no Details tab: {titles}")
    if "Info" in pages:
        problems.append(f"the old combined Info tab is still there: {titles}")
    if problems:
        raise AssertionError("; ".join(problems))

    if descends(pane.details_grid, pages["Ports"]):
        problems.append("Details still shares the Ports tab")
    if not descends(pane.details_grid, pages["Details"]):
        problems.append("the Details grid is not on the Details tab")
    if not descends(pane.ports_box, pages["Ports"]):
        problems.append("the port list is not on the Ports tab")
    if not descends(pane.clone_button, pages["Snapshots"]):
        problems.append("Clone is not on the Snapshots tab")
    if descends(pane.clone_button, pages["Hardware"]):
        problems.append("Clone is still on the Hardware tab")
    # The whole copies block travels together. Marking a template is what makes
    # a clone cheap, so splitting the switch from the thing it exists for is the
    # regression this guards against.
    for label, widget in (
        ("Mark as template", pane.template_button),
        ("the template explanation", pane.template_hint),
    ):
        if not descends(widget, pages["Snapshots"]):
            problems.append(f"{label} is not on the Snapshots tab")
        if descends(widget, pages["Hardware"]):
            problems.append(f"{label} is still on the Hardware tab")
    if problems:
        raise AssertionError("; ".join(problems))

    exercised.append("Ports and Details are separate tabs, the copies block moved whole")
    print(
        "  \033[32mPASS\033[0m  Ports and Details are separate tabs, "
        "the copies block moved whole"
    )

    # ---- a refresh must not overwrite a field while it is being typed in ----
    # The poll used to write into these fields regardless of focus, and
    # set_text() moves the caret. Typing "asda" saved "456asda" -- which is what
    # reached the Remmina profile -- and choosing a folder in Browse looked like
    # it had selected nothing, because the dialog took the focus and the poll put
    # the old path straight back.
    typing_pane = VmPane(window, VM)
    try:
        st = lifecycle.status(VM)
        typing_pane.update(st)

        account = typing_pane.rdp_user_entry
        typed = ""
        for char in "asda":
            account.set_text(typed + char)   # one keystroke
            typed += char
            account.set_position(len(typed))  # caret at the end, as typing leaves it
            typing_pane.update(st)           # the poll fires mid-word

        share = typing_pane.share_entry
        share.set_text("/tmp/picked-folder")
        share.set_position(len("/tmp/picked-folder"))
        typing_pane.update(st)

        problems = []
        if account.get_text() != "asda":
            problems.append(f"typing 'asda' left {account.get_text()!r} in the field")
        if account.get_position() != 4:
            problems.append(f"the caret jumped to {account.get_position()}, not 4")
        if share.get_text() != "/tmp/picked-folder":
            problems.append(
                f"a folder chosen in Browse was overwritten with {share.get_text()!r}"
            )
        if problems:
            raise AssertionError("; ".join(problems))

        exercised.append("a refresh never overwrites a field being typed in")
        print("  \033[32mPASS\033[0m  a refresh never overwrites a field being typed in")
    finally:
        typing_pane.close()

    # ---- switching away must not stop the log for good ----
    other = next((n for n in window.order if n != VM), None)
    if other:
        rebuild_pane(window, VM)
        window.select_vm(VM)
        before = window.panes[VM]._log_tag
        window.select_vm(other)
        window.select_vm(VM)
        tag = window.panes[VM]._log_tag
        if before and tag == before:
            exercised.append("the log timer survives switching away and back")
            print("  \033[32mPASS\033[0m  the log timer survives switching away and back")
        else:
            failures.append((
                "log timer",
                f"timer {before} before switching, {tag} after",
            ))
            print(
                "  \033[31mFAIL\033[0m  the log timer did not survive switching "
                f"away and back ({before} -> {tag})"
            )
        settle()

    # ---- the log poll must not run podman on the main loop ----
    # _poll_logs is a GLib timeout, so it runs on the main loop. It was
    # calling `podman logs` and `podman container exists` from there --
    # two subprocesses, every two seconds, for every open pane.
    # Stub out the dispatch as well as podman, so nothing runs on a thread
    # and the only thing measured is what the main loop itself did.
    live_pane = window.panes[VM]
    window.select_vm(VM)
    settle()
    calls: list[str] = []
    dispatched: list[object] = []
    real_run_async = workers.run_async
    real_logs, real_exists = podman.logs, podman.exists
    workers.run_async = lambda work, **kw: dispatched.append((work, kw))
    podman.logs = lambda *a, **k: calls.append("logs") or "line\n"
    podman.exists = lambda *a, **k: calls.append("exists") or True
    try:
        live_pane._log_reading = False
        shown = live_pane.is_visible()
        kept = live_pane._poll_logs(live_pane._log_source)
        blocked, queued = list(calls), len(dispatched)
    finally:
        workers.run_async = real_run_async
        podman.logs, podman.exists = real_logs, real_exists
        live_pane._log_reading = False
    if shown and kept and queued == 1 and not blocked:
        exercised.append("the log poll does not shell out on the main loop")
        print("  \033[32mPASS\033[0m  the log poll does not shell out on the main loop")
    else:
        failures.append((
            "log poll blocks the UI",
            f"visible {shown}, kept timer {kept}, called {blocked}, dispatched {queued}",
        ))
        print(
            "  \033[31mFAIL\033[0m  the log poll ran "
            f"{blocked} on the main loop (dispatched {queued})"
        )

    # ---- the New VM dialog must notice a size that is typed in ----
    # RAM and Disk had no "changed" handler, so a good value could be
    # replaced with a bad one and Create stayed enabled -- and the dialog
    # closed before the failure was reported anywhere.
    dialog = newvm.NewVmDialog(window)
    dialog.name_entry.set_text("guicheck-newvm")
    settle_dialog()
    dialog.ram_entry.set_text("banana")
    settle_dialog()
    if not dialog.create_button.get_sensitive():
        exercised.append("a bad RAM size disables Create as it is typed")
        print("  \033[32mPASS\033[0m  a bad RAM size disables Create as it is typed")
    else:
        failures.append((
            "newvm validation",
            "RAM was set to 'banana' and Create is still enabled",
        ))
        print("  \033[31mFAIL\033[0m  a bad RAM size left Create enabled")
    dialog.ram_entry.set_text("2G")
    settle_dialog()
    if dialog.create_button.get_sensitive():
        exercised.append("fixing the size enables Create again")
        print("  \033[32mPASS\033[0m  fixing the size enables Create again")
    else:
        failures.append(("newvm validation", "a good RAM size did not re-enable Create"))
        print("  \033[31mFAIL\033[0m  a good RAM size left Create disabled")

    # Creating a VM that already exists used to fail in the worker, after
    # the dialog had closed.
    dialog.name_entry.set_text(VM)
    settle_dialog()
    if not dialog.create_button.get_sensitive():
        exercised.append("an existing VM name disables Create")
        print("  \033[32mPASS\033[0m  an existing VM name disables Create")
    else:
        failures.append((
            "newvm validation",
            f"{VM!r} already exists and Create is still enabled",
        ))
        print("  \033[31mFAIL\033[0m  an existing VM name left Create enabled")
    dialog.close()

    # The first row of the Blueprint list is "(none)": no blueprint. It was
    # used as a name, so the default row of the default dialog greeted you
    # with "no such blueprint: (none)".
    blank = newvm.NewVmDialog(window)
    blank_hint = blank.blueprint_desc.get_text()
    blank_ok = blank._blueprint_name() == "" and "invalid blueprint" not in blank_hint
    blank.close()
    if blank_ok:
        exercised.append('"(none)" means no blueprint, not a blueprint named (none)')
        print("  \033[32mPASS\033[0m  \"(none)\" means no blueprint, not a broken one")
    else:
        failures.append((
            "none blueprint",
            f"selected {blank._blueprint_name()!r}, hint said {blank_hint!r}",
        ))
        print("  \033[31mFAIL\033[0m  the default blueprint option is not usable")

    # ---- Delete has to be reachable, and right-click has to not be fatal ----
    # Right-clicking a VM row popped up a menu that had no parent widget.
    # GTK4 realised it outside the hierarchy, got no surface, and killed
    # the process. Delete was only in that menu, so the crash also meant
    # there was no way to delete a VM at all.
    popovers: list[Gtk.PopoverMenu] = []
    for widget in _walk(window):
        if isinstance(widget, Gtk.PopoverMenu):
            popovers.append(widget)
    orphan = [p for p in popovers if p.get_parent() is None]
    if popovers and not orphan:
        exercised.append("right-clicking a VM opens its menu without dying")
        print("  \033[32mPASS\033[0m  right-clicking a VM opens its menu without dying")
    else:
        failures.append((
            "row menu popover",
            f"{len(popovers)} found, {len(orphan)} without a parent",
        ))
        print(
            f"  \033[31mFAIL\033[0m  {len(orphan)} of {len(popovers)} row-menu "
            "popovers have no parent (right-click would kill the app)"
        )

    # Gio.Menu sections are opaque to PyGObject -- get_item_attribute_value
    # returns None for "section" -- so the menu's contents are asserted from
    # the source in selftest rather than here.

    # And Delete has a button, which is the point: dissolving the Actions tab
    # left the one action that cannot be undone reachable only by right-click.
    header_buttons = {
        w.get_label()
        for w in _walk(pane.header_bar)
        if isinstance(w, Gtk.Button)
    }
    if any(label and label.startswith("Delete") for label in header_buttons):
        exercised.append("Delete has a button in the pane header")
        print("  \033[32mPASS\033[0m  Delete has a button in the pane header")
    else:
        failures.append((
            "delete button missing",
            f"header has {sorted(b for b in header_buttons if b)}",
        ))
        print("  \033[31mFAIL\033[0m  there is no Delete button in the pane header")

    # A menu item is greyed out when its action cannot be resolved, and the
    # label still renders perfectly well while greyed -- so this is invisible
    # in a screenshot and has to be asked of the widget that owns the menu.
    #
    # "row.delete" means "the action delete in the group named row". These
    # actions used to live on the window, which a popover parented to a
    # sidebar row does not resolve: every item was a no-op. Asking the
    # window -- which is what a test naturally reaches for -- passes anyway,
    # because the window did have them. So this asks the popover.
    #
    # The probe action is added to the app's own group and does nothing, so
    # resolution is exercised with no side effect on any VM.
    row_popover = next(
        (
            w for w in _walk(window)
            if isinstance(w, Gtk.PopoverMenu)
            and isinstance(w.get_parent(), Gtk.ListBoxRow)
        ),
        None,
    )
    row_group = getattr(window, "row_actions", None)
    if row_popover is None or row_group is None:
        failures.append(("row popover", "no row-parented popover or no action group"))
        print("  \033[31mFAIL\033[0m  no row-parented popover with an action group")
    else:
        probe_action = Gio.SimpleAction.new("guicheck_resolves", None)
        row_group.add_action(probe_action)
        resolves = row_popover.activate_action("row.guicheck_resolves", None)

        menu_source = inspect.getsource(window._attach_row_menu)
        row_actions = sorted(set(re.findall(r'"row\.(\w+)::', menu_source)))
        missing = []
        for kind in row_actions:
            action = row_group.lookup_action(kind)
            if action is None:
                missing.append(f"row.{kind} (not in the group)")
                continue
            vtype = action.get_parameter_type()
            if vtype is None or vtype.dup_string() != "s":
                missing.append(f"row.{kind} (takes no VM name)")
        if resolves and row_actions and not missing:
            exercised.append("the sidebar menu's actions resolve from the row popover")
            print(
                f"  \033[32mPASS\033[0m  the sidebar menu's {len(row_actions)} actions "
                "resolve from the row popover"
            )
        else:
            failures.append((
                "sidebar menu actions",
                f"popover resolves={resolves}, menu names {row_actions}, "
                f"unusable: {missing or 'none found'}",
            ))
            print(
                f"  \033[31mFAIL\033[0m  sidebar menu actions do not resolve "
                f"(popover resolves={resolves}): {missing}"
            )

    # The header's overflow menu asks for win.* and needs its own group for
    # the same reason. It carries no VM name, so a parameterless probe works.
    win_group = getattr(window, "win_actions", None)
    header_popover = next(
        (
            w for w in _walk(window)
            if isinstance(w, Gtk.PopoverMenu)
            and isinstance(w.get_parent(), Gtk.MenuButton)
        ),
        None,
    )
    win_resolves = False
    if header_popover is not None and win_group is not None:
        win_group.add_action(Gio.SimpleAction.new("guicheck_resolves", None))
        win_resolves = header_popover.activate_action("win.guicheck_resolves", None)
    if win_resolves:
        exercised.append("the header overflow menu's actions resolve")
        print("  \033[32mPASS\033[0m  the header overflow menu's actions resolve")
    else:
        failures.append((
            "header menu actions",
            f"popover={header_popover is not None} group={win_group is not None} "
            f"resolves={win_resolves}",
        ))
        print("  \033[31mFAIL\033[0m  the header overflow menu's actions do not resolve")

    # ---- the tab you are on carries over to a VM you have not opened ----
    # Every new pane used to open on the Console, so comparing two machines
    # meant clicking back to the same tab every time you switched.
    window.select_vm(VM)
    if window._tab == 0:
        exercised.append("the app opens on the Console tab")
        print("  \033[32mPASS\033[0m  the app opens on the Console tab")
    else:
        failures.append(("startup tab", f"opened on page {window._tab}, not 0"))
        print(f"  \033[31mFAIL\033[0m  the app did not open on the Console (page {window._tab})")

    if other is None:
        print("  \033[33mSKIP\033[0m  only one VM exists; cannot test the tab carrying over")
    else:
        pages = window.panes[VM].notebook.get_n_pages()
        target = 3 if pages > 3 else pages - 1
        window.panes[VM].notebook.set_current_page(target)
        settle()
        rebuild_pane(window, other)
        window.select_vm(other)
        landed = window.panes[other].notebook.get_current_page()
        if landed == target:
            exercised.append("a new VM opens on the tab you were using")
            print("  \033[32mPASS\033[0m  a new VM opens on the tab you were using")
        else:
            failures.append((
                "tab not carried over",
                f"was on page {target}, the new pane opened on {landed}",
            ))
            print(
                "  \033[31mFAIL\033[0m  a new VM ignored the tab you were on "
                f"({target} -> {landed})"
            )
        # Put everything back on the Console so the checks below start where the
        # probe expects to, and a failure above cannot cascade.
        window.panes[VM].notebook.set_current_page(0)
        settle()
        window.select_vm(other)
        window.select_vm(VM)
        settle()

    # ---- adding a custom forward, pressed the way a user presses it ----
    # Calling the handler with no arguments is not enough: GTK hands the
    # button to "clicked", so a zero-argument handler dies on the press and
    # the control looks fine and does nothing. Pass the button, fill in the
    # dialog's own fields, and press its Add button.
    def find_named(widget, name):
        if widget is None:
            return None
        if widget.get_name() == name:
            return widget
        child = widget.get_first_child()
        while child is not None:
            found = find_named(child, name)
            if found is not None:
                return found
            child = child.get_next_sibling()
        return None

    add_dialogs: list = []
    saved_present = widgets.TextPrompt.present
    widgets.TextPrompt.present = lambda self: (add_dialogs.append(self), saved_present(self))[1]
    try:
        pane._on_add_port(None)
        dialog = add_dialogs[-1] if add_dialogs else None
        guest = find_named(dialog, "vmhub.port.guest")
        if guest is None:
            failures.append((
                "forward dialog unusable",
                "the Add dialog opened without its fields",
            ))
            print("  \033[31mFAIL\033[0m  Forward another port… opened no usable dialog")
        else:
            guest.set_text("5432")
            host_field = find_named(dialog, "vmhub.port.host")
            host_field.set_text("16050")
            dialog.accept_button.emit("clicked")
            pump_until(
                lambda: 16050 in registry.load_spec(VM).network.published()
            )
            if 16050 in registry.load_spec(VM).network.published():
                exercised.append("a custom port can be added from the port table")
                print("  \033[32mPASS\033[0m  a custom port can be added from the port table")
            else:
                failures.append((
                    "add port did nothing",
                    "filling the dialog and pressing Add changed nothing",
                ))
                print("  \033[31mFAIL\033[0m  filling the dialog and pressing Add did nothing")
            # A mistyped guest number has to be correctable in place. It
            # used to mean removing the entry and adding it again, losing
            # the port and the label the user had given it.
            target = next(
                (p for p in registry.load_spec(VM).network.ports if p.host == 16050), None
            )
            if target is None:
                failures.append(("edit port", "the port to edit was not there"))
                print("  \033[31mFAIL\033[0m  the port to edit was not there")
            else:
                add_dialogs.clear()
                pane._on_change_port(target)
                edit = add_dialogs[-1] if add_dialogs else None
                edit_guest = find_named(edit, "vmhub.port.guest") if edit else None
                if edit_guest is None:
                    failures.append((
                        "edit dialog unusable",
                        "the Edit dialog opened without a guest field",
                    ))
                    print("  \033[31mFAIL\033[0m  the Edit dialog opened without a guest field")
                elif edit_guest.get_text() != "5432":
                    failures.append((
                        "edit dialog not prefilled",
                        f"the guest field showed {edit_guest.get_text()!r}, not '5432'",
                    ))
                    print("  \033[31mFAIL\033[0m  the Edit dialog did not show the current guest port")
                else:
                    edit_guest.set_text("5433")
                    edit.accept_button.emit("clicked")
                    pump_until(
                        lambda: 5433 in registry.load_spec(VM).network.published().values()
                    )
                    published = registry.load_spec(VM).network.published()
                    forwarded = registry.load_spec(VM).network.guest_ports
                    if 5433 in published.values() and 16050 in published:
                        exercised.append("a mistyped guest port can be corrected in place")
                        print("  \033[32mPASS\033[0m  a mistyped guest port can be corrected in place")
                    else:
                        failures.append((
                            "edit guest port did nothing",
                            f"published is {published}",
                        ))
                        print("  \033[31mFAIL\033[0m  editing the guest port changed nothing")
                    if 5432 not in forwarded and 5433 in forwarded:
                        exercised.append("the old guest port stops being forwarded")
                        print("  \033[32mPASS\033[0m  the old guest port stops being forwarded")
                    else:
                        failures.append((
                            "stale guest forward",
                            f"guest_ports is {forwarded}",
                        ))
                        print("  \033[31mFAIL\033[0m  the old guest port is still forwarded")

            # and it can be taken away again from the same table
            for child_port in list(registry.load_spec(VM).network.ports):
                if child_port.host == 16050:
                    pane._on_remove_port(child_port)
                    break
            pump_until(lambda: 16050 not in registry.load_spec(VM).network.published())
            if 16050 not in registry.load_spec(VM).network.published():
                exercised.append("a custom port can be removed from the port table")
                print("  \033[32mPASS\033[0m  a custom port can be removed from the port table")
            else:
                failures.append((
                    "remove port did nothing",
                    "the Remove button on a custom port changed nothing",
                ))
                print("  \033[31mFAIL\033[0m  removing a custom port changed nothing")
    finally:
        widgets.TextPrompt.present = saved_present
        for leaked in add_dialogs:
            leaked.close()

    # a running VM's disk is locked, so cloning it must be disabled
    live = "vmhub-guicheck-live"
    lifecycle.create(live, blueprint="alpine")
    lifecycle.start(live)
    settle()
    window.select_vm(live)
    sensitive = window.panes[live].clone_button.get_sensitive()
    lifecycle.stop(live, mode="force")
    lifecycle.remove(live)
    settle()
    if sensitive:
        failures.append(("clone enabled while running", "disk is locked"))
        print("  \033[31mFAIL\033[0m  Clone… was enabled on a running VM")
    else:
        exercised.append("Clone is disabled while the VM runs")
        print("  \033[32mPASS\033[0m  Clone… is disabled while the VM runs")

    # ---- progress messages must actually be shown ----
    strip = window.status_strip
    seen: list[str] = []
    original_push = strip.push

    def recording_push(message: str, **kwargs) -> None:
        seen.append(message)
        original_push(message, **kwargs)

    strip.push = recording_push  # type: ignore[method-assign]
    try:
        widgets.run_task(
            window,
            lambda progress: (progress("halfway through"), True)[1],
            label="test task",
        )
        pump_until(lambda: "halfway through" in seen)
    finally:
        strip.push = original_push  # type: ignore[method-assign]

    if "halfway through" not in seen:
        failures.append(("progress not displayed", str(seen)))
        print(f"  \033[31mFAIL\033[0m  run_task progress never reached the strip: {seen}")
    else:
        exercised.append("run_task progress reaches the status strip")
        print("  \033[32mPASS\033[0m  run_task progress reaches the status strip")

    # ---- refresh must not block the main loop ----
    started = time.time()
    window.refresh()
    blocked = (time.time() - started) * 1000
    if blocked > 250:
        failures.append(("refresh blocks", f"{blocked:.0f} ms"))
        print(f"  \033[31mFAIL\033[0m  refresh() blocked for {blocked:.0f} ms")
    else:
        exercised.append("refresh is non-blocking")
        print(f"  \033[32mPASS\033[0m  refresh() returned in {blocked:.0f} ms")

    window.refresh()
    window.refresh()
    if window._refreshing and not window._refresh_pending:
        failures.append(("refresh stacking", "overlap not coalesced"))
        print("  \033[31mFAIL\033[0m  overlapping refresh was not coalesced")
    else:
        exercised.append("refresh coalesces overlap")
        print("  \033[32mPASS\033[0m  overlapping refresh is coalesced")

    # Pump the main loop so the worker's idle callback actually runs.
    pump_until(lambda: bool(getattr(window, "statuses", {})))
    if not getattr(window, "statuses", {}):
        failures.append(("async refresh", "statuses never populated"))
        print("  \033[31mFAIL\033[0m  async refresh never populated statuses")
    else:
        exercised.append("async refresh populates statuses")
        print(
            f"  \033[32mPASS\033[0m  async refresh populated {len(window.statuses)} VMs"
        )

    typed: list[str] = []
    prompt = widgets.TextPrompt(window, "H", "B", default="d", on_accept=typed.append)
    prompt.entry.set_text("guicheck")
    prompt.accept_button.emit("clicked")
    check("TextPrompt returns the typed text", lambda: _assert(typed == ["guicheck"], typed))

    # ---- a URL that cannot be opened must say so ----
    # open_url is the only path to a browser, and it used to fail two
    # ways that both looked like success: the else branch shelled out to
    # xdg-open exactly when which() had said it was absent, and the live
    # branch passed three Nones to launch(), discarding the GError.
    #
    # This harness runs with VMHUB_NO_LAUNCH=1, so open_url returns on its
    # first line and has never been reached. Clear it around both checks
    # and restore it after, or an assertion here would pass or fail for
    # the wrong reason entirely.
    saved_flag = os.environ.pop("VMHUB_NO_LAUNCH", None)
    try:
        # No launcher on PATH: report the URL rather than fall through to
        # a branch that shells out to the program which() just said is
        # missing. Stub the module attribute, not shutil.which itself --
        # widgets.shutil IS the shutil module, so assigning through it
        # would replace which() for the whole process.
        real_shutil = widgets.shutil
        widgets.shutil = _NoLauncher()
        try:
            nothing_installed: list[str] = []
            widgets.open_url(
                "http://127.0.0.1:1/console", report=nothing_installed.append
            )
        finally:
            widgets.shutil = real_shutil
        check(
            "with no launcher installed, open_url reports instead of raising",
            lambda: _assert(
                bool(nothing_installed), f"nothing reported: {nothing_installed}"
            ),
        )
        check(
            "and the report repeats the URL so it can still be reached",
            lambda: _assert(
                any("127.0.0.1:1" in m for m in nothing_installed),
                f"none of {nothing_installed} repeats the URL",
            ),
        )

        # The silent-launch defect itself. UriLauncher.launch() is async
        # and under Xvfb its callback never runs, so assert the wiring
        # rather than the outcome: launch() must be handed a callback,
        # because that is what carries the GError. Substituting the class
        # makes that deterministic and needs no portal.
        real_launcher = widgets.Gtk.UriLauncher
        seen: list[object] = []

        class _RecordingLauncher:
            """Records what open_url hands launch().

            UriLauncher.new is a static factory, so the stand-in needs
            a new() too -- open_url calls Gtk.UriLauncher.new(url) and
            never constructs the class directly.
            """

            def __init__(self, uri):
                seen.append(uri)

            @staticmethod
            def new(uri):
                return _RecordingLauncher(uri)

            def launch(self, cancellable, parent, callback):
                seen.append(callback)

        widgets.Gtk.UriLauncher = _RecordingLauncher
        try:
            widgets.open_url("http://127.0.0.1:8006/", report=lambda _m: None)
        finally:
            widgets.Gtk.UriLauncher = real_launcher
        check(
            "open_url hands launch() a callback so a GError is not discarded",
            lambda: _assert(
                len(seen) == 2 and callable(seen[1]),
                f"launch() got {seen!r}; a None callback discards the error",
            ),
        )
        check(
            "open_url no longer shells out to a launcher it just found missing",
            lambda: _assert(
                "subprocess" not in _widgets_source(),
                "widgets still imports subprocess for the old dead branch",
            ),
        )
    finally:
        if saved_flag is not None:
            os.environ["VMHUB_NO_LAUNCH"] = saved_flag

    # ---- the ports table says how far each published port reaches ----
    # Exposure lived only in a checkbox inside the Change dialog, so the
    # table could not answer "which of my ports are open to the network"
    # without opening Change once per row. The label is only worth having
    # if it matches the -p podman is really given, so most of what follows
    # is that agreement rather than the wording.
    scope_vm = f"{VM}-scope"
    lifecycle.create(scope_vm, blueprint="alpine")
    scope_pane = VmPane(window, scope_vm)

    def _write_scope_spec(network_bind: str, ssh_bind: str, extra_bind: str) -> None:
        vm_spec = registry.load_spec(scope_vm)
        vm_spec.network.bind = network_bind
        vm_spec.network.ports = [
            spec.Port(guest=22, host=2222, role="ssh", bind=ssh_bind),
            spec.Port(guest=8080, host=18080, name="extra", bind=extra_bind),
        ]
        vm_spec.validate()
        registry.save_spec(vm_spec)

    def _row_scopes() -> tuple[list[str], list[str]]:
        """The scope text on each role row and each extra row."""
        scope_pane._refresh_ports()
        roles = [
            w.get_label()
            for w in _walk(scope_pane.roles_box)
            if w.get_name() == "vmhub.port.scope"
        ]
        extras = [
            w.get_label()
            for w in _walk(scope_pane.ports_box)
            if w.get_name() == "vmhub.port.scope"
        ]
        return roles, extras

    def _expected_scopes() -> list[str]:
        """What the rows should say, worked out from podman's own argv."""
        argv = podman.run_argv(registry.load_spec(scope_vm), "uuid", "mac", None)
        out = []
        for i, arg in enumerate(argv):
            if arg != "-p":
                continue
            bind = argv[i + 1].split(":")[0]
            out.append(
                # Spelled out here on purpose. Inside _probe the name
                # "pane" is a local holding one VmPane instance, and it
                # shadows the ui.pane module of the same name.
                "Exposed" if bind in ("0.0.0.0", "*") else "Localhost only"
            )
        return sorted(out)

    _write_scope_spec("127.0.0.1", "", "0.0.0.0")
    roles, extras = _row_scopes()
    check(
        "every published port says how far it reaches",
        lambda: _assert(
            roles == ["Localhost only"] and extras == ["Exposed"],
            f"the ssh row says {roles}, the extra row says {extras}",
        ),
    )
    check(
        "what the row says is what podman is actually given",
        lambda: _assert(
            sorted(roles + extras) == _expected_scopes(),
            f"rows say {sorted(roles + extras)}, argv implies "
            f"{_expected_scopes()}",
        ),
    )

    # A port with no bind of its own inherits network.bind, so a
    # network-wide exposure reaches ports that never mention it. Reading
    # only port.bind calls these local while podman publishes them to the
    # LAN. It also proves _refresh_ports notices network.bind: without it
    # in the signature the refresh below returns early and the row is
    # still saying "Localhost only".
    _write_scope_spec("0.0.0.0", "", "0.0.0.0")
    roles, extras = _row_scopes()
    check(
        "a port that inherits a network-wide exposure says so",
        lambda: _assert(
            roles == ["Exposed"] and extras == ["Exposed"],
            f"the ssh row still says {roles} after network.bind went to "
            "0.0.0.0",
        ),
    )

    # And the other direction: a network-wide loopback bind does not drag
    # a per-port 0.0.0.0 back to local.
    _write_scope_spec("127.0.0.1", "", "0.0.0.0")
    roles, extras = _row_scopes()
    check(
        "a per-port exposure survives a loopback network bind",
        lambda: _assert(
            roles == ["Localhost only"] and extras == ["Exposed"],
            f"the ssh row says {roles}, the extra row says {extras}",
        ),
    )

    # The flow the user actually complained about: tick the box once and
    # the table says so, with no need to reopen anything.
    edit_dialogs: list = []
    saved_present = widgets.TextPrompt.present
    widgets.TextPrompt.present = lambda self: (
        edit_dialogs.append(self), saved_present(self)
    )[1]
    try:
        extra_port = registry.load_spec(scope_vm).network.ports[1]
        scope_pane._on_change_port(extra_port)
        dialog = edit_dialogs[-1] if edit_dialogs else None
        expose_box = find_named(dialog, "vmhub.port.expose")
        if expose_box is None:
            check(
                "ticking the expose box updates the row",
                lambda: _assert(
                    False, "the Change dialog opened without its expose checkbox"
                ),
            )
        else:
            expose_box.set_active(False)
            settle_dialog()
            dialog.accept_button.emit("clicked")
            pump_until(
                lambda: registry.load_spec(scope_vm)
                .network.ports[1]
                .bind
                == ""
            )
            roles, extras = _row_scopes()
            check(
                "ticking the expose box updates the row without reopening it",
                lambda: _assert(
                    extras == ["Localhost only"],
                    f"after unticking, the extra row says {extras}",
                ),
            )
    finally:
        widgets.TextPrompt.present = saved_present

    scope_pane.close()
    window.panes.pop(scope_vm, None)
    if registry.exists(scope_vm):
        lifecycle.remove(scope_vm)

    # ---- closing the window is the one thing that does stop a log timer ----
    # Kept out of the sweep above, and asserted here on a pane that is known to
    # be watching: a timer left running past app shutdown keeps the VM name and
    # its callback alive for nothing.
    watching = [n for n, p in window.panes.items() if p._log_tag]
    window._on_close(None)
    still_watching = [n for n, p in window.panes.items() if p._log_tag]
    if watching and not still_watching:
        exercised.append("closing the window stops every log timer")
        print("  \033[32mPASS\033[0m  closing the window stops every log timer")
    else:
        failures.append((
            "log timers outlived the window",
            f"watching {watching} before close, {still_watching} after",
        ))
        print(
            "  \033[31mFAIL\033[0m  log timers outlived the window close "
            f"({watching} -> {still_watching})"
        )

    lifecycle.stop(VM, force=True)
    lifecycle.remove(VM)

    # The sweep must not have taken a user's VM with it.
    vanished = sorted(preexisting - set(registry.all_names()))
    if vanished:
        failures.append((
            "the sweep removed a user's VM",
            f"gone: {vanished}",
        ))
        print(
            f"  \033[31mFAIL\033[0m  the handler sweep removed {vanished} "
            "-- VMs that existed before this run"
        )
    else:
        exercised.append("the handler sweep removes no VM it did not create")
        print(
            "  \033[32mPASS\033[0m  the handler sweep removed none of the "
            f"{len(preexisting)} VM(s) that already existed"
        )

    print()
    if failures:
        print(f"\033[31m{len(failures)} check(s) failed:\033[0m")
        for label, err in failures:
            print(f"    - {label}: {err}")
    else:
        print(f"\033[32mall {len(exercised)} GUI checks passed\033[0m")


class _NoLauncher:
    """A stand-in for the shutil module whose which() finds nothing."""

    @staticmethod
    def which(_name, *_args, **_kwargs):
        return None


def _widgets_source() -> str:
    from vmhub.ui import widgets as widgets_mod

    import inspect as _inspect

    return _inspect.getsource(widgets_mod)


def _assert(condition: bool, value: object) -> None:
    if not condition:
        raise AssertionError(f"got {value!r}")


if __name__ == "__main__":
    app = VmhubApp()
    ran = []

    def guarded_probe() -> bool:
        ran.append(True)
        if app.window is None:
            print("  \033[31mFAIL\033[0m  the application never created a window")
            failures.append(("no window", "run() returned before activation"))
            app.quit()
            return False
        probe(app)
        return False

    GLib.timeout_add(1200, guarded_probe)
    app.run([])
    if not ran:
        print("  \033[31mFAIL\033[0m  the probe never ran — the main loop exited first")
        failures.append(("probe", "main loop ended before the probe fired"))
    sys.exit(1 if failures else 0)
