#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
# See the comment in ./vmhub: this script's own directory is the project
# root, and an explicit VMHUB_HOME still takes precedence over it.
export VMHUB_HOME="${VMHUB_HOME:-$HERE}"
exec python3 -m vmhub.cli "$@"
